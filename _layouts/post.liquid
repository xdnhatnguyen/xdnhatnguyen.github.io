---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="portfolio-page portfolio-page--post" data-portfolio-page>
  <div class="portfolio-noise" aria-hidden="true"></div>
  <div class="portfolio-shell">
    <header class="portfolio-hero" style="min-height: auto; padding: 2rem 0 3rem; grid-template-columns: minmax(0, 1fr) auto;">
      <div class="portfolio-hero-copy">
        <p class="portfolio-kicker">
          — {% if url_beginning == '/blog/' %}Blog / {{ page.categories | join: ', ' | default: 'Note' }}{% else %}Article / {{ page.categories | join: ', ' | default: 'Post' }}{% endif %}
        </p>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.05; margin: 0.5rem 0;">{{ page.title }}</h1>
        {% if page.description %}
          <p class="portfolio-hero-description" style="margin-top: 1rem !important;">{{ page.description }}</p>
        {% endif %}
        
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.5rem; font-size: 0.82rem; opacity: 0.85; color: var(--portfolio-fg);">
          <span>📅 {{ page.date | date: '%B %d, %Y' }}</span>
          {% if page.author %}<span>✍️ {{ page.author }}</span>{% endif %}
          {% assign read_time = page.content | number_of_words | divided_by: 180 | plus: 1 %}
          <span>⏱️ {{ read_time }} min read</span>
          {% if categories != '' %}
            {% for category in page.categories %}
              {% if url_beginning == '/blog/' %}
                <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}" class="portfolio-tag" style="border-color: var(--portfolio-accent); font-weight: 600; text-decoration: none;">@{{ category }}</a>
              {% else %}
                <span class="portfolio-tag" style="border-color: var(--portfolio-accent); font-weight: 600;">@{{ category }}</span>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        {% if tags != '' %}
          <div class="portfolio-tags" style="margin-top: 1rem;" aria-label="Post tags">
            {% for tag in page.tags %}
              {% if url_beginning == '/blog/' %}
                <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}" class="portfolio-tag" style="text-decoration: none;"># {{ tag }}</a>
              {% else %}
                <span class="portfolio-tag"># {{ tag }}</span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="portfolio-hero-aside" style="align-self: flex-start;">
        <a class="portfolio-button portfolio-button--ghost" href="{{ '/blog/' | relative_url }}" style="font-size: 0.75rem; padding: 0.35rem 0.85rem; text-decoration: none; display: inline-flex;">
          ← Back to Blog
        </a>
      </div>
    </header>

    <main class="portfolio-post-body" style="padding: 3rem 0;">
      {% if page.toc and page.toc.beginning %}
        <div id="table-of-contents" style="margin-bottom: 2rem; padding: 1.25rem 1.5rem; background: var(--portfolio-surface, rgba(255, 255, 255, 0.03)); border: 1px solid var(--portfolio-border); border-radius: 12px;">
          {% toc %}
        </div>
      {% endif %}

      <article class="portfolio-prose" id="markdown-content" style="line-height: 1.8; font-size: 1.05rem;">
        {{ content }}
      </article>

      {% if page.citation %}
        <div style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--portfolio-border);">
          {% include citation.liquid %}
        </div>
      {% endif %}

      {% if page.related_publications %}
        <div style="margin-top: 3rem;">
          <h2 style="font-family: var(--portfolio-display); font-size: 2rem; border-bottom: 1px solid var(--portfolio-border); padding-bottom: 0.5rem;">References</h2>
          <div class="publications">
            {% bibliography --group_by none --cited_in_order %}
          </div>
        </div>
      {% endif %}

      {% if site.related_blog_posts and site.related_blog_posts.enabled %}
        {% if page.related_posts == null or page.related_posts %}
          <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px dashed var(--portfolio-border);">
            {% include related_posts.liquid %}
          </div>
        {% endif %}
      {% endif %}

      {% if site.disqus_shortname and page.disqus_comments %}
        <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px dashed var(--portfolio-border);">
          {% include disqus.liquid %}
        </div>
      {% endif %}
      {% if site.giscus and page.giscus_comments %}
        <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px dashed var(--portfolio-border);">
          {% include giscus.liquid %}
        </div>
      {% endif %}
    </main>
  </div>
</div>
