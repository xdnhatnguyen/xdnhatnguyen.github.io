t be 21+. Play at your own\n            discretion.</p>\n          <div class=\"foot-badges\" data-kid=\"588\">\n            <span class=\"chip\" style=\"color:var(--muted)\" data-kid=\"589\">LICENSED · CW-2024-0148</span>\n            <span class=\"chip g\" data-kid=\"590\">PROVABLY FAIR</span>\n            <span class=\"chip p\" data-kid=\"591\">21+ ONLY</span>\n          </div>\n        </div>\n        <div class=\"foot-col\" data-kid=\"592\">\n          <h5 data-kid=\"593\">PLAY</h5>\n          <ul data-kid=\"594\">\n            <li data-kid=\"595\"><a href=\"#lobby\" data-kid=\"596\">Lobby</a></li>\n            <li data-kid=\"597\"><a href=\"#lobby\" data-kid=\"598\">Live tables</a></li>\n            <li data-kid=\"599\"><a href=\"#lobby\" data-kid=\"600\">Jackpots</a></li>\n            <li data-kid=\"601\"><a href=\"#lobby\" data-kid=\"602\">Sportsbook</a></li>\n          </ul>\n        </div>\n        <div class=\"foot-col\" data-kid=\"603\">\n          <h5 data-kid=\"604\">HELP &amp; LIMITS</h5>\n          <ul data-kid=\"605\">\n            <li data-kid=\"606\"><a href=\"#lobby\" data-kid=\"607\"><span class=\"d\" data-kid=\"608\">●</span> Responsible play tools</a></li>\n            <li data-kid=\"609\"><a href=\"#lobby\" data-kid=\"610\"><span class=\"d\" data-kid=\"611\">●</span> Self-exclude</a></li>\n            <li data-kid=\"612\"><a href=\"#lobby\" data-kid=\"613\"><span class=\"d\" data-kid=\"614\">●</span> Gambling helpline 24/7</a></li>\n            <li data-kid=\"615\"><a href=\"#provably\" data-kid=\"616\">Provably fair docs</a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n    <div class=\"foot-bottom\" data-kid=\"617\">© 2024 NEON.SLOTS — render 0x9F3a…E2c1 · build 3.14.2 · neo-tokyo node</div>\n  </footer>\n\n  <script data-kid=\"618\">\n    (function () {\n      const reduce = false;\n      var isTouch = window.matchMedia('(hover: none), (pointer: coarse)').matches;\n\n      /* ---- counters (jackpot + session) ---- */\n      var jp = document.getElementById('jackpot'), v = 2481693.42;\n      if (jp) setInterval(function () { v += Math.random() * 1.5 + 0.05; jp.textContent = '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }, 500);\n      var st = document.getElementById('sessionTime'), s = 3600 + 24 * 60 + 18;\n      if (st) setInterval(function () { s++; var h = String(Math.floor(s / 3600)).padStart(2, '0'), m = String(Math.floor((s % 3600) / 60)).padStart(2, '0'), x = String(s % 60).padStart(2, '0'); st.textContent = h + ':' + m + ':' + x; }, 1000);\n\n      /* ---- on-load hero fan-in ---- */\n      requestAnimationFrame(function () { requestAnimationFrame(function () { document.body.classList.add('is-in'); }); });\n\n      /* ---- IntersectionObserver entrance triggers ---- */\n      var io = new IntersectionObserver(function (es) {\n        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });\n      }, { threshold: 0.18 });\n      ['#tiltGrid', '#provably', '#vaultPin', '#leaderboard', '#footer'].forEach(function (sel) {\n        var el = document.querySelector(sel); if (el) io.observe(el);\n      });\n      // leaderboard rail reveal staggered after rows enter\n      var lbSec = document.querySelector('.lb');\n      if (lbSec) {\n        var rio = new IntersectionObserver(function (es) {\n          es.forEach(function (e) {\n            if (e.isIntersecting) {\n              var rows = document.querySelectorAll('.lb-row'); rows.forEach(function (r, i) { setTimeout(function () { r.classList.add('shown'); }, 200 + i * 70); }); rio.disconnect();\n            }\n          });\n        }, { threshold: 0.2 });\n        rio.observe(lbSec);\n      }\n\n      /* ---- rAF scroll loop ---- */\n      var scrollY = window.scrollY, ticking = false, vel = 0, lastY = scrollY;\n      var stack = document.getElementById('stack');\n      var cards = stack ? stack.querySelectorAll('.card') : [];\n      var stackZone = document.getElementById('stackZone');\n      var pfOuter = document.getElementById('provably'), pfPanels = document.querySelectorAll('.pf-panel'), pfProg = document.querySelectorAll('.pf-progress i');\n      var vaultOuter = document.getElementById('vault'), vpanels = document.querySelectorAll('.vpanel');\n      var ticker = document.getElementById('ticker'), tickX = 0, tickW = 0;\n      if (ticker) { var first = ticker.querySelector('.grp'); if (first) tickW = first.offsetWidth; }\n\n      function clamp(n, a, b) { return Math.min(b, Math.max(a, n)); }\n\n      var heroOuter = document.getElementById('heroOuter');\n      var deckTicks = document.querySelectorAll('.deck-prog i');\n\n      function update() {\n        /* hero pinned card-swap: scrubbing scroll flicks each card off, one by one */\n        if (stack && cards.length && !reduce && heroOuter && window.innerWidth > 1080) {\n          var ro = heroOuter.getBoundingClientRect();\n          var total = heroOuter.offsetHeight - window.innerHeight;\n          var prog = clamp((-ro.top) / total, 0, 1);\n          var N = cards.length;\n          var raw = clamp(prog * N, 0, N - 1);          // continuous active-card index\n          for (var i = 0; i < N; i++) {\n            var d = i - raw, tx, ty, tz, ry, rz, sc, op, z;\n            if (d <= 0) {                            // front card, or one being flicked away (up + forward)\n              var t = clamp(-d, 0, 1.2);\n              tx = 16 * t; ty = -56 * t; tz = 70 * t; ry = 8 * t; rz = 10 * t;\n              sc = 1 - 0.02 * Math.min(t, 1); op = clamp(1 - t * 1.25, 0, 1); z = Math.round((4 - d) * 100);\n            } else {                             // cards still waiting behind, receding into the deck\n              var dd = Math.min(d, 3);\n              tx = 0; ty = 4 * dd; tz = -30 * dd; ry = 0; rz = 0;\n              sc = 1 - 0.05 * dd; op = dd < 2.6 ? 1 : clamp(1 - (dd - 2.6) / 0.5, 0, 1); z = Math.round((4 - dd) * 100);\n            }\n            var c = cards[i];\n            c.style.transform = 'translate3d(' + tx.toFixed(2) + '%,' + ty.toFixed(2) + '%,' + tz.toFixed(1) + 'px) rotateY(' + ry.toFixed(2) + 'deg) rotateZ(' + rz.toFixed(2) + 'deg) scale(' + sc.toFixed(3) + ')';\n            c.style.opacity = op.toFixed(3);\n            c.style.zIndex = z;\n          }\n          var cur = clamp(Math.round(raw), 0, N - 1);\n          deckTicks.forEach(function (tk, k) { tk.classList.toggle('on', k === cur); });\n        }\n\n        /* provably fair: pinned split — swap panels by scroll segment */\n        if (pfOuter) {\n          var ro = pfOuter.getBoundingClientRect();\n          var total = pfOuter.offsetHeight - window.innerHeight;\n          var pp = clamp((-ro.top) / total, 0, 1);\n          var seg = Math.min(2, Math.floor(pp * 3));\n          pfPanels.forEach(function (el) { el.classList.toggle('active', +el.dataset.p === seg); });\n          pfProg.forEach(function (el, idx) { el.classList.toggle('on', idx === seg); });\n          if (pp > 0.05) { revealTermOut(); }\n        }\n\n        /* vault: sticky-stacked panels — activity slides up over deposit */\n        if (vaultOuter && !reduce) {\n          var vr = vaultOuter.getBoundingClientRect();\n          var vt = vaultOuter.offsetHeight - window.innerHeight;\n          var vp = clamp((-vr.top) / vt, 0, 1);\n          // deposit (v0) recedes 1->0.96 + dims; activity (v1) rises from below\n          var dep = vpanels[0], act = vpanels[1];\n          if (dep && act) {\n            var sc = 1 - 0.04 * clamp(vp * 1.4, 0, 1);\n            dep.style.transform = 'scale(' + sc.toFixed(3) + ')';\n            dep.style.opacity = (1 - 0.35 * clamp((vp - 0.35) / 0.4, 0, 1)).toFixed(3);\n            var rise = (1 - clamp((vp - 0.2) / 0.55, 0, 1)) * 100;\n            act.style.transform = 'translateY(' + rise.toFixed(1) + '%)';\n            act.style.opacity = clamp((vp - 0.15) / 0.3, 0, 1).toFixed(3);\n            act.style.zIndex = 2;\n          }\n        }\n\n        /* ticker base drift + velocity boost */\n        if (ticker && tickW > 0 && !reduce) {\n          var boost = 1 + Math.min(6, Math.abs(vel) * 0.06);\n          tickX -= (0.6 * boost);\n          if (tickX <= -tickW) tickX += tickW;\n          ticker.style.transform = 'translateX(' + tickX.toFixed(1) + 'px)';\n        }\n        vel *= 0.9;\n        ticking = false;\n      }\n\n      var termRevealed = false;\n      function revealTermOut() {\n        if (termRevealed) return; termRevealed = true;\n        var lns = document.querySelectorAll('#termOut .ln');\n        lns.forEach(function (l, i) { setTimeout(function () { l.classList.add('show'); }, i * 180); });\n      }\n\n      function onScroll() {\n        scrollY = window.scrollY; vel += (scrollY - lastY); lastY = scrollY;\n        if (!ticking) { requestAnimationFrame(update); ticking = true; }\n      }\n      window.addEventListener('scroll', onScroll, { passive: true });\n\n      /* continuous rAF for ticker drift even without scrolling */\n      function loop() { if (!ticking) { requestAnimationFrame(update); ticking = true; } requestAnimationFrame(loop); }\n      if (!reduce) requestAnimationFrame(loop);\n\n      /* ---- hero card mouse-tilt (desktop only) ---- */\n      if (stack && !isTouch && !reduce) {\n        var sz = document.getElementById('stackZone');\n        sz.addEventListener('mousemove', function (e) {\n          var r = sz.getBoundingClientRect();\n          var mx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);\n          var my = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);\n          if (!ticking) {\n            requestAnimationFrame(function () {\n              stack.style.transform = 'rotateY(' + (mx * 9).toFixed(2) + 'deg) rotateX(' + (-my * 7).toFixed(2) + 'deg)';\n            });\n          }\n        });\n        sz.addEventListener('mouseleave', function () { stack.style.transform = 'rotateY(0) rotateX(0)'; });\n      }\n\n      /* ---- lobby tilt-grid mouse rotateX/Y (desktop only) ---- */\n      var grid = document.getElementById('tiltGrid');\n      if (grid && !isTouch && !reduce) {\n        var gTiles = grid.querySelectorAll('.tile'), gTick = false, gmx = 0, gmy = 0;\n        grid.addEventListener('mousemove', function (e) {\n          var r = grid.getBoundingClientRect();\n          gmx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);\n          gmy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);\n          if (!gTick) {\n            requestAnimationFrame(function () {\n              gTiles.forEach(function (t) { t.style.transform = 'perspective(1400px) rotateY(' + (gmx * 4).toFixed(2) + 'deg) rotateX(' + (-gmy * 4).toFixed(2) + 'deg)'; });\n              gTick = false;\n            }); gTick = true;\n          }\n        });\n        grid.addEventListener('mouseleave', function () { gTiles.forEach(function (t) { t.style.transform = 'perspective(1400px) rotateY(0) rotateX(0)'; }); });\n      }\n    })();\n  </script>\n",
