  "nodes": {
    "node_paste_34052dce9748": {
      "type": "variant",
      "id": "node_paste_34052dce9748",
      "label": "Neon Slots",
      "html": "<style>\n    :root {\n      --bg: #13182B;\n      /* lacquer indigo night ground */\n      --panel: #1B2138;\n      /* raised washi-indigo surface */\n      --panel-2: #222949;\n      --ink: #F3EAD6;\n      /* washi cream ink */\n      --muted: #9AA0BE;\n      /* fog-indigo secondary */\n      --persimmon: #FF5A2C;\n      /* CTA / live / payout */\n      --jade: #27C29A;\n      /* verify / confirm / safety */\n      --gold: #E8B23A;\n      /* jackpot / featured / rank-1 seams */\n      --line: rgba(243, 234, 214, .10);\n      --line-2: rgba(243, 234, 214, .20);\n      --ease: cubic-bezier(.16, 1, .3, 1);\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0\n    }\n\n    html {\n      scroll-behavior: smooth\n    }\n\n    body {\n      background: var(--bg);\n      color: var(--ink);\n      font-family: 'Spline Sans', sans-serif;\n      font-size: 16px;\n      line-height: 1.62;\n      -webkit-font-smoothing: antialiased;\n      overflow-x: hidden;\n    }\n\n    h1,\n    h2,\n    h3,\n    h4 {\n      font-family: 'Anton', sans-serif;\n      font-weight: 400;\n      text-transform: uppercase;\n      letter-spacing: .01em;\n      line-height: .94\n    }\n\n    .mono {\n      font-family: 'Spline Sans Mono', monospace\n    }\n\n    .label {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .14em;\n      text-transform: uppercase\n    }\n\n    a {\n      color: inherit;\n      text-decoration: none;\n      cursor: pointer\n    }\n\n    button {\n      font-family: inherit;\n      cursor: pointer;\n      border: none;\n      background: none;\n      color: inherit\n    }\n\n    img {\n      display: block;\n      max-width: 100%\n    }\n\n    .wrap {\n      max-width: 1320px;\n      margin: 0 auto;\n      padding: 0 28px\n    }\n\n    section {\n      position: relative\n    }\n\n    :focus-visible {\n      outline: 2px solid var(--gold);\n      outline-offset: 3px\n    }\n\n    /* lacquer paper-grain background texture (no orbs/glows) */\n    .lacquer-grain {\n      position: fixed;\n      inset: 0;\n      pointer-events: none;\n      z-index: 0;\n      opacity: .5;\n      background-image:\n        linear-gradient(rgba(243, 234, 214, .022) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(243, 234, 214, .022) 1px, transparent 1px);\n      background-size: 72px 72px;\n    }\n\n    /* ---- buttons ---- */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      padding: 15px 26px;\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .06em;\n      font-size: 14px;\n      transition: transform .4s var(--ease), background .25s ease, color .25s ease;\n      clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px)\n    }\n\n    .btn-fill {\n      background: var(--persimmon);\n      color: #13182B\n    }\n\n    .btn-fill:hover {\n      background: #ff6f47;\n      transform: translateY(-2px)\n    }\n\n    .btn-gold {\n      background: var(--gold);\n      color: #13182B\n    }\n\n    .btn-gold:hover {\n      background: #f0c25c;\n      transform: translateY(-2px)\n    }\n\n    .btn-jade {\n      background: var(--jade);\n      color: #0a1410\n    }\n\n    .btn-jade:hover {\n      background: #3ad6ad;\n      transform: translateY(-2px)\n    }\n\n    .btn-line {\n      border: 1px solid var(--line-2);\n      color: var(--ink)\n    }\n\n    .btn-line:hover {\n      border-color: var(--gold);\n      color: var(--gold)\n    }\n\n    .chip {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n      padding: 5px 10px;\n      border: 1px solid var(--line-2);\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px)\n    }\n\n    .seam {\n      height: 2px;\n      background: linear-gradient(90deg, transparent, var(--gold), transparent)\n    }\n\n    /* corner seam panel */\n    .panel {\n      background: var(--panel);\n      border: 1px solid var(--line-2);\n      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px)\n    }\n\n    /* ---- header ---- */\n    header {\n      position: sticky;\n      top: 0;\n      z-index: 60;\n      background: rgba(19, 24, 43, .92);\n      backdrop-filter: blur(8px);\n      border-bottom: 1px solid var(--line)\n    }\n\n    .hd-row {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n      padding: 13px 28px;\n      max-width: 1320px;\n      margin: 0 auto\n    }\n\n    .logo {\n      font-family: 'Anton', sans-serif;\n      font-size: 21px;\n      letter-spacing: .14em\n    }\n\n    .logo b {\n      color: var(--persimmon);\n      font-weight: 400\n    }\n\n    .mark {\n      width: 30px;\n      height: 30px;\n      position: relative;\n      flex: 0 0 auto\n    }\n\n    .mark svg {\n      position: absolute;\n      inset: 0\n    }\n\n    .hd-nav {\n      display: flex;\n      gap: 22px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      letter-spacing: .12em;\n      text-transform: uppercase\n    }\n\n    .hd-nav a {\n      color: var(--muted);\n      transition: color .2s\n    }\n\n    .hd-nav a:hover,\n    .hd-nav a.on {\n      color: var(--gold)\n    }\n\n    .hd-right {\n      margin-left: auto;\n      display: flex;\n      align-items: center;\n      gap: 12px\n    }\n\n    .hd-tick {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      padding: 6px 11px;\n      border: 1px solid var(--line-2);\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px);\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      color: var(--muted)\n    }\n\n    .dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: var(--persimmon)\n    }\n\n    @keyframes pulse {\n\n      0%,\n      100% {\n        opacity: .55\n      }\n\n      50% {\n        opacity: 1\n      }\n    }\n\n    .pulse {\n      animation: pulse 1.4s ease-in-out infinite\n    }\n\n    /* =================== HERO =================== */\n    /* pinned hero: outer wrapper gives scroll budget, inner pins for card-swap */\n    .hero-outer {\n      position: relative;\n      z-index: 1;\n      height: 380vh\n    }\n\n    .hero {\n      position: sticky;\n      top: 0;\n      height: 100vh;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      justify-content: flex-start;\n      padding: clamp(80px, 12vh, 110px) 0 clamp(20px, 4vh, 40px)\n    }\n\n    .hero-top {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: clamp(20px, 4vh, 46px)\n    }\n\n    .hero-top .chips {\n      display: flex;\n      gap: 10px;\n      flex-wrap: wrap\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.45fr 1fr;\n      gap: 50px;\n      align-items: start\n    }\n\n    .eyebrow {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      letter-spacing: .34em;\n      color: var(--gold);\n      text-transform: uppercase;\n      margin-bottom: 20px\n    }\n\n    h1.hero-h {\n      font-size: clamp(44px, min(7.4vw, 11vh), 112px);\n      line-height: 0.95\n    }\n\n    .hero-h .ln {\n      display: block;\n      overflow: hidden\n    }\n\n    .hero-h .ln span {\n      display: block;\n      transform: translateY(110%);\n      transition: transform .9s var(--ease)\n    }\n\n    .is-in .hero-h .ln span {\n      transform: translateY(0)\n    }\n\n    .hero-h .ln:nth-child(2) span {\n      transition-delay: .09s\n    }\n\n    .hero-h .ln:nth-child(3) span {\n      transition-delay: .18s\n    }\n\n    .c-per {\n      color: var(--persimmon)\n    }\n\n    .c-gold {\n      color: var(--gold)\n    }\n\n    .hero-body {\n      max-width: 54ch;\n      color: var(--muted);\n      font-size: 17px;\n      line-height: 1.5;\n      margin-top: clamp(14px, 2.4vh, 26px)\n    }\n\n    .jackpot {\n      display: inline-flex;\n      margin-top: clamp(18px, 3vh, 34px);\n      border: 1px solid rgba(232, 178, 58, .5);\n      background: var(--panel);\n      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px)\n    }\n\n    .jackpot .cell {\n      padding: 12px 22px\n    }\n\n    .jackpot .div {\n      width: 1px;\n      background: var(--line-2);\n      margin: 12px 0\n    }\n\n    .jackpot .big {\n      font-family: 'Anton', sans-serif;\n      font-size: clamp(32px, 4vw, 46px);\n      color: var(--gold);\n      font-variant-numeric: tabular-nums;\n      margin-top: 4px\n    }\n\n    .jackpot .next {\n      font-family: 'Anton', sans-serif;\n      font-size: 22px;\n      margin-top: 4px\n    }\n\n    .hero-cta {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 13px;\n      margin-top: clamp(18px, 3vh, 34px)\n    }\n\n    .hero-cta .addr {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      color: var(--muted);\n      margin-left: 6px\n    }\n\n    /* card deck — sized to ~64% of hero height, scroll swaps cards one-by-one */\n    .stack-zone {\n      position: relative;\n      perspective: 1600px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 26px\n    }\n\n    .stack {\n      position: relative;\n      height: min(56vh, 520px);\n      aspect-ratio: 300/418;\n      width: auto;\n      margin: 0;\n      transform-style: preserve-3d\n    }\n\n    .card {\n      position: absolute;\n      inset: 0;\n      border-radius: 14px;\n      overflow: hidden;\n      border: 1px solid var(--line-2);\n      background: var(--panel-2);\n      transform-style: preserve-3d;\n      will-change: transform, opacity;\n      backface-visibility: hidden;\n      box-shadow: 0 30px 60px -28px rgba(0, 0, 0, .7);\n      transform: scale(.95);\n      opacity: 0;\n      transition: none\n    }\n\n    .is-in .card {\n      opacity: 1\n    }\n\n    .deck-prog {\n      display: flex;\n      gap: 8px\n    }\n\n    .deck-prog i {\n      width: 30px;\n      height: 3px;\n      background: var(--line-2);\n      transition: background .3s\n    }\n\n    .deck-prog i.on {\n      background: var(--gold)\n    }\n\n    .card img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      opacity: .9\n    }\n\n    .card .cap {\n      position: absolute;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      padding: 14px;\n      background: linear-gradient(to top, rgba(19, 24, 43, .94), transparent)\n    }\n\n    .card .cap h4 {\n      font-size: 18px\n    }\n\n    .card .cap .rtp {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      color: var(--gold);\n      margin-top: 3px\n    }\n\n    .card .face-fallback {\n      position: absolute;\n      inset: 0;\n      display: flex;\n      align-items: flex-end\n    }\n\n    .card[data-i=\"0\"] .face-fallback {\n      background: linear-gradient(150deg, #3a2547, var(--panel-2))\n    }\n\n    .card[data-i=\"1\"] .face-fallback {\n      background: linear-gradient(150deg, #103a33, var(--panel-2))\n    }\n\n    .card[data-i=\"2\"] .face-fallback {\n      background: linear-gradient(150deg, #4a2a13, var(--panel-2))\n    }\n\n    .card[data-i=\"3\"] .face-fallback {\n      background: linear-gradient(150deg, #2a1a3f, var(--panel-2))\n    }\n\n    .wax {\n      position: absolute;\n      top: 16px;\n      right: 16px;\n      width: 54px;\n      height: 54px;\n      border-radius: 50%;\n      background: var(--persimmon);\n      color: #13182B;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-family: 'Anton', sans-serif;\n      font-size: 14px;\n      transform: rotate(-12deg);\n      box-shadow: 0 6px 16px -6px rgba(0, 0, 0, .6);\n      z-index: 4\n    }\n\n    .spine {\n      position: absolute;\n      left: -58px;\n      top: 60px;\n      writing-mode: vertical-rl;\n      transform: rotate(180deg);\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .24em;\n      color: var(--gold);\n      text-transform: uppercase\n    }\n\n    .ledger {\n      position: static;\n      transform: none;\n      display: flex;\n      flex-direction: row;\n      flex-wrap: wrap;\n      gap: 30px;\n      justify-content: center\n    }\n\n    .ledger .item {\n      border-left: none;\n      padding-left: 0;\n      text-align: center\n    }\n\n    .ledger .num {\n      font-family: 'Anton', sans-serif;\n      font-size: 30px;\n      font-variant-numeric: tabular-nums\n    }\n\n    .ledger .num.per {\n      color: var(--persimmon)\n    }\n\n    .ledger .num.gold {\n      color: var(--gold)\n    }\n\n    .ledger .l {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 10px;\n      letter-spacing: .1em;\n      color: var(--muted);\n      text-transform: uppercase;\n      margin-top: 2px\n    }\n\n    /* =================== TICKER (#30) =================== */\n    .ticker {\n      z-index: 5;\n      background: var(--panel);\n      border-top: 1px solid rgba(232, 178, 58, .4);\n      border-bottom: 1px solid rgba(232, 178, 58, .4);\n      padding: 14px 0;\n      overflow: hidden;\n      transform: rotate(-1.4deg);\n      margin: 8px 0\n    }\n\n    .ticker-track {\n      display: flex;\n      white-space: nowrap;\n      will-change: transform;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 15px\n    }\n\n    .ticker-track .grp {\n      display: flex;\n      align-items: center;\n      gap: 44px;\n      padding-right: 44px\n    }\n\n    .ticker-track .amt {\n      color: var(--gold);\n      font-weight: 600\n    }\n\n    .ticker-track .game {\n      color: var(--ink)\n    }\n\n    .ticker-track .h {\n      color: var(--muted)\n    }\n\n    .ticker-track .di {\n      color: var(--persimmon)\n    }\n\n    /* =================== LOBBY (#25 tilt-grid-3d) =================== */\n    .lobby {\n      padding: 96px 0;\n      z-index: 1\n    }\n\n    .lobby-layout {\n      display: grid;\n      grid-template-columns: 1fr 348px;\n      gap: 46px;\n      align-items: start\n    }\n\n    .sec-head {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 18px;\n      margin-bottom: 38px\n    }\n\n    .sec-eye {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      letter-spacing: .18em;\n      color: var(--gold);\n      text-transform: uppercase;\n      margin-bottom: 12px\n    }\n\n    .sec-h {\n      font-size: clamp(38px, 5vw, 62px)\n    }\n\n    .sec-sub {\n      color: var(--muted);\n      margin-top: 12px;\n      max-width: 46ch;\n      font-size: 15px\n    }\n\n    .filters {\n      display: flex;\n      gap: 8px;\n      flex-wrap: wrap\n    }\n\n    .filters .chip.on {\n      border-color: var(--gold);\n      color: var(--gold)\n    }\n\n    .tilt-grid {\n      display: grid;\n      grid-template-columns: repeat(12, 1fr);\n      gap: 16px;\n      perspective: 1400px\n    }\n\n    .tile {\n      position: relative;\n      overflow: hidden;\n      border: 1px solid var(--line-2);\n      background: var(--panel-2);\n      border-radius: 10px;\n      transform-style: preserve-3d;\n      will-change: transform;\n      transition: transform .5s var(--ease), border-color .3s;\n      min-height: 160px;\n      transform: translateY(28px);\n      opacity: 0\n    }\n\n    .tilt-grid.is-in .tile {\n      transform: translateY(0);\n      opacity: 1;\n      transition: transform .8s var(--ease), opacity .8s var(--ease), border-color .3s\n    }\n\n    .tilt-grid.is-in .tile:nth-child(1) {\n      transition-delay: .05s\n    }\n\n    .tilt-grid.is-in .tile:nth-child(2) {\n      transition-delay: .11s\n    }\n\n    .tilt-grid.is-in .tile:nth-child(3) {\n      transition-delay: .17s\n    }\n\n    .tilt-grid.is-in .tile:nth-child(4) {\n      transition-delay: .23s\n    }\n\n    .tilt-grid.is-in .tile:nth-child(5) {\n      transition-delay: .29s\n    }\n\n    .tilt-grid.is-in .tile:nth-child(6) {\n      transition-delay: .35s\n    }\n\n    .tilt-grid.is-in .tile:nth-child(7) {\n      transition-delay: .41s\n    }\n\n    .tile:hover {\n      border-color: var(--persimmon)\n    }\n\n    .tile img {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      opacity: .62\n    }\n\n    .tile .grad {\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(to top, rgba(19, 24, 43, .95), rgba(19, 24, 43, .25) 55%, transparent)\n    }\n\n    .tile .body {\n      position: absolute;\n      inset: 0;\n      padding: 16px;\n      display: flex;\n      flex-direction: column;\n      justify-content: flex-end;\n      transform: translateZ(34px)\n    }\n\n    .tile .tag-tl {\n      position: absolute;\n      top: 12px;\n      left: 12px;\n      display: flex;\n      gap: 6px;\n      flex-wrap: wrap;\n      transform: translateZ(40px)\n    }\n\n    .tile .tag-tr {\n      position: absolute;\n      top: 12px;\n      right: 12px;\n      transform: translateZ(40px)\n    }\n\n    .tag-feat {\n      background: var(--persimmon);\n      color: #13182B;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 10px;\n      letter-spacing: .08em;\n      padding: 3px 7px;\n      text-transform: uppercase\n    }\n\n    .tag-jack {\n      background: var(--gold);\n      color: #13182B;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 10px;\n      letter-spacing: .08em;\n      padding: 3px 7px;\n      text-transform: uppercase\n    }\n\n    .tag-new {\n      background: var(--jade);\n      color: #0a1410;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 10px;\n      letter-spacing: .08em;\n      padding: 3px 7px;\n      text-transform: uppercase\n    }\n\n    .tag-rtp {\n      background: rgba(19, 24, 43, .8);\n      border: 1px solid rgba(232, 178, 58, .5);\n      color: var(--gold);\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      padding: 3px 8px\n    }\n\n    .tile h3 {\n      font-size: 26px\n    }\n\n    .tile h4 {\n      font-size: 18px\n    }\n\n    .tile .meta {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-top: 8px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      color: var(--muted);\n      gap: 10px\n    }\n\n    .tile .meta .live {\n      color: var(--gold)\n    }\n\n    .tile.feat {\n      grid-column: span 7;\n      grid-row: span 2;\n      min-height: 368px\n    }\n\n    .tile.med {\n      grid-column: span 5;\n      min-height: 176px\n    }\n\n    .tile.sm {\n      grid-column: span 3;\n      min-height: 152px\n    }\n\n    .term-card {\n      position: absolute;\n      top: 14px;\n      right: 14px;\n      background: rgba(19, 24, 43, .82);\n      border: 1px solid rgba(232, 178, 58, .5);\n      padding: 9px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      transform: translateZ(46px);\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px)\n    }\n\n    .term-card .g {\n      color: var(--gold)\n    }\n\n    .term-card .i {\n      color: var(--ink)\n    }\n\n    .term-card .m {\n      color: var(--muted)\n    }\n\n    .lobby-foot {\n      grid-column: span 12;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border: 1px solid var(--line-2);\n      padding: 15px 18px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      color: var(--muted);\n      clip-path: polygon(8px 0, 100% 0, 100% 100%, 0 100%, 0 8px)\n    }\n\n    .lobby-foot button {\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .1em;\n      font-size: 13px;\n      color: var(--gold)\n    }\n\n    .lobby-foot button:hover {\n      color: var(--ink)\n    }\n\n    /* responsible play aside */\n    .aside {\n      position: sticky;\n      top: 86px;\n      display: flex;\n      flex-direction: column;\n      gap: 20px\n    }\n\n    .lifeline {\n      position: relative\n    }\n\n    .lifeline .lab {\n      position: absolute;\n      top: -10px;\n      left: 16px;\n      background: var(--bg);\n      padding: 0 8px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .12em;\n      color: var(--jade);\n      text-transform: uppercase;\n      z-index: 2\n    }\n\n    .life-card {\n      border: 1px solid rgba(39, 194, 154, .55);\n      background: var(--panel);\n      padding: 24px;\n      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px)\n    }\n\n    .life-card h3 {\n      font-size: 22px;\n      margin-bottom: 8px\n    }\n\n    .life-card h3 .j {\n      color: var(--jade)\n    }\n\n    .life-card p {\n      font-size: 14px;\n      color: var(--muted);\n      line-height: 1.55\n    }\n\n    .life-card p .hi {\n      color: var(--jade)\n    }\n\n    .meter {\n      border: 1px solid var(--line);\n      padding: 14px;\n      background: rgba(19, 24, 43, .45);\n      margin-top: 18px\n    }\n\n    .meter .row {\n      display: flex;\n      justify-content: space-between;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      margin-bottom: 8px\n    }\n\n    .meter .row .t {\n      color: var(--muted)\n    }\n\n    .meter .row .v {\n      color: var(--jade);\n      display: flex;\n      align-items: center;\n      gap: 6px\n    }\n\n    .meter .v .dot {\n      background: var(--jade)\n    }\n\n    .meter .big {\n      font-family: 'Anton', sans-serif;\n      font-size: 30px;\n      font-variant-numeric: tabular-nums\n    }\n\n    .bar {\n      height: 4px;\n      background: var(--line);\n      margin-top: 12px;\n      overflow: hidden;\n      border-radius: 2px\n    }\n\n    .bar i {\n      display: block;\n      height: 100%;\n      width: 42%;\n      background: var(--jade)\n    }\n\n    .bar-scale {\n      display: flex;\n      justify-content: space-between;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 10px;\n      color: var(--muted);\n      margin-top: 6px\n    }\n\n    .rng {\n      -webkit-appearance: none;\n      appearance: none;\n      width: 100%;\n      height: 4px;\n      background: linear-gradient(90deg, var(--jade), var(--gold));\n      border-radius: 2px;\n      outline: none;\n      margin-top: 4px\n    }\n\n    .rng::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      width: 18px;\n      height: 18px;\n      border-radius: 50%;\n      background: var(--jade);\n      border: 2px solid var(--bg);\n      cursor: pointer\n    }\n\n    .rng::-moz-range-thumb {\n      width: 18px;\n      height: 18px;\n      border-radius: 50%;\n      background: var(--jade);\n      border: 2px solid var(--bg);\n      cursor: pointer\n    }\n\n    .life-trio {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 8px;\n      margin-top: 16px\n    }\n\n    .life-trio button {\n      padding: 9px 4px;\n      border: 1px solid var(--line);\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 10px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      color: var(--ink);\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px);\n      transition: border-color .2s\n    }\n\n    .life-trio button:hover {\n      border-color: var(--jade)\n    }\n\n    .self-ex {\n      margin-top: 18px;\n      width: 100%;\n      padding: 16px;\n      background: var(--persimmon);\n      color: #13182B;\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .16em;\n      font-size: 15px;\n      clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);\n      transition: background .2s\n    }\n\n    .self-ex:hover {\n      background: #ff6f47\n    }\n\n    .self-note {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      color: var(--muted);\n      text-align: center;\n      margin-top: 12px\n    }\n\n    .vault-snap {\n      border: 1px solid var(--line-2);\n      background: var(--panel);\n      padding: 20px;\n      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px)\n    }\n\n    .vault-snap .v {\n      font-family: 'Anton', sans-serif;\n      font-size: 26px;\n      color: var(--gold);\n      margin-top: 4px\n    }\n\n    .vault-snap .sub {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      color: var(--muted);\n      margin-top: 4px\n    }\n\n    .vault-snap .acts {\n      display: flex;\n      gap: 8px;\n      margin-top: 14px\n    }\n\n    .vault-snap .acts .btn {\n      flex: 1;\n      justify-content: center;\n      padding: 11px;\n      font-size: 12px\n    }\n\n    /* =================== PROVABLY FAIR (#22 pinned split) =================== */\n    .pf-outer {\n      height: 320vh;\n      position: relative;\n      z-index: 1;\n      border-top: 1px solid var(--line)\n    }\n\n    .pf-pin {\n      position: sticky;\n      top: 0;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      overflow: hidden\n    }\n\n    .pf-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 54px;\n      align-items: center;\n      width: 100%\n    }\n\n    .pf-left {\n      position: relative\n    }\n\n    .pf-h {\n      font-size: clamp(44px, 6.5vw, 90px)\n    }\n\n    .pf-h .strike {\n      color: var(--persimmon);\n      position: relative\n    }\n\n    .pf-h .strike::after {\n      content: \"\";\n      position: absolute;\n      left: -2%;\n      right: -2%;\n      top: 52%;\n      height: 4px;\n      background: var(--persimmon);\n      transform: scaleX(0);\n      transform-origin: left;\n      transition: transform .6s var(--ease)\n    }\n\n    .is-in .pf-h .strike::after {\n      transform: scaleX(1);\n      transition-delay: .4s\n    }\n\n    .pf-steps {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n      max-width: 430px;\n      margin-top: 34px\n    }\n\n    .pf-step {\n      padding-top: 12px\n    }\n\n    .pf-step.s1 {\n      border-top: 2px solid var(--gold)\n    }\n\n    .pf-step.s2 {\n      border-top: 2px solid var(--persimmon)\n    }\n\n    .pf-step.s3 {\n      border-top: 2px solid var(--jade)\n    }\n\n    .pf-step .n {\n      font-family: 'Anton', sans-serif;\n      font-size: 30px\n    }\n\n    .pf-step.s1 .n {\n      color: var(--gold)\n    }\n\n    .pf-step.s2 .n {\n      color: var(--persimmon)\n    }\n\n    .pf-step.s3 .n {\n      color: var(--jade)\n    }\n\n    .pf-step .lab {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n      margin-top: 8px\n    }\n\n    .pf-step .d {\n      font-size: 12px;\n      color: var(--muted);\n      margin-top: 4px\n    }\n\n    .pf-panels {\n      position: relative;\n      min-height: 200px;\n      margin-top: 30px\n    }\n\n    .pf-panel {\n      position: absolute;\n      inset: 0;\n      opacity: 0;\n      transform: translateY(24px);\n      transition: opacity .5s var(--ease), transform .5s var(--ease);\n      pointer-events: none\n    }\n\n    .pf-panel.active {\n      opacity: 1;\n      transform: translateY(0);\n      pointer-events: auto\n    }\n\n    .pf-panel p {\n      color: var(--muted);\n      font-size: 16px;\n      line-height: 1.66;\n      max-width: 50ch\n    }\n\n    .pf-panel p .g {\n      color: var(--gold)\n    }\n\n    .pf-panel p .per {\n      color: var(--persimmon)\n    }\n\n    .pf-panel p .j {\n      color: var(--jade)\n    }\n\n    .pf-progress {\n      display: flex;\n      gap: 8px;\n      margin-top: 18px\n    }\n\n    .pf-progress i {\n      width: 34px;\n      height: 3px;\n      background: var(--line-2);\n      transition: background .3s\n    }\n\n    .pf-progress i.on {\n      background: var(--gold)\n    }\n\n    /* terminal (locked visual) */\n    .term {\n      border: 1px solid rgba(232, 178, 58, .5);\n      background: var(--panel);\n      overflow: hidden;\n      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px)\n    }\n\n    .term-bar {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 11px 16px;\n      border-bottom: 1px solid var(--line);\n      background: rgba(19, 24, 43, .6)\n    }\n\n    .term-bar .lights {\n      display: flex;\n      gap: 6px\n    }\n\n    .term-bar .lights i {\n      width: 10px;\n      height: 10px;\n      border-radius: 50%\n    }\n\n    .term-bar .lights i:nth-child(1) {\n      background: var(--persimmon)\n    }\n\n    .term-bar .lights i:nth-child(2) {\n      background: var(--gold)\n    }\n\n    .term-bar .lights i:nth-child(3) {\n      background: var(--jade)\n    }\n\n    .term-bar span {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      color: var(--muted)\n    }\n\n    .term-bar span.g {\n      color: var(--gold)\n    }\n\n    .term-body {\n      padding: 24px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13.5px;\n      line-height: 1.75\n    }\n\n    .term-body .ln {\n      margin-bottom: 5px\n    }\n\n    .tg {\n      color: var(--gold)\n    }\n\n    .ti {\n      color: var(--ink)\n    }\n\n    .tm {\n      color: var(--muted)\n    }\n\n    .tp {\n      color: var(--persimmon)\n    }\n\n    .tj {\n      color: var(--jade)\n    }\n\n    .term-in {\n      display: block;\n      width: 100%;\n      background: var(--bg);\n      border: 1px solid var(--line-2);\n      padding: 9px 11px;\n      color: var(--gold);\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      margin-top: 5px;\n      outline: none;\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px)\n    }\n\n    .term-in:focus {\n      border-color: var(--gold)\n    }\n\n    .term-in.ink {\n      color: var(--ink);\n      border-color: var(--line-2)\n    }\n\n    .term-2 {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n      margin-top: 14px\n    }\n\n    .term-btn {\n      width: 100%;\n      margin-top: 16px;\n      padding: 11px;\n      background: var(--gold);\n      color: #13182B;\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .14em;\n      font-size: 13px;\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px)\n    }\n\n    .term-out {\n      border-top: 1px solid var(--line);\n      margin-top: 18px;\n      padding-top: 16px\n    }\n\n    .term-out .ln {\n      opacity: 0;\n      transform: translateX(-8px);\n      transition: opacity .35s, transform .35s\n    }\n\n    .term-out .ln.show {\n      opacity: 1;\n      transform: translateX(0)\n    }\n\n    @keyframes blink {\n      50% {\n        opacity: 0\n      }\n    }\n\n    .cursor {\n      animation: blink 1s steps(1) infinite\n    }\n\n    /* =================== VAULT (#21 sticky-stack) =================== */\n    .vault-outer {\n      height: 250vh;\n      position: relative;\n      z-index: 1;\n      border-top: 1px solid var(--line);\n      background: rgba(27, 33, 56, .4)\n    }\n\n    .vault-pin {\n      position: sticky;\n      top: 0;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      padding: 40px 0;\n      overflow: hidden\n    }\n\n    .vault-head {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 16px;\n      margin-bottom: 26px\n    }\n\n    .vault-net {\n      display: flex;\n      gap: 18px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px\n    }\n\n    .vault-net .eth {\n      color: var(--gold);\n      display: flex;\n      align-items: center;\n      gap: 7px\n    }\n\n    .vault-net .btc {\n      color: var(--persimmon);\n      display: flex;\n      align-items: center;\n      gap: 7px\n    }\n\n    .vault-net .eth .dot {\n      background: var(--gold)\n    }\n\n    .vault-net .btc .dot {\n      background: var(--persimmon)\n    }\n\n    .vault-stack {\n      position: relative;\n      min-height: 520px\n    }\n\n    .vpanel {\n      position: absolute;\n      inset: 0;\n      will-change: transform, opacity;\n      transition: transform .1s linear\n    }\n\n    .vpanel .panel {\n      padding: 28px;\n      height: 100%\n    }\n\n    .vault-tabs {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      border-bottom: 1px solid var(--line);\n      margin-bottom: 22px\n    }\n\n    .vault-tabs button {\n      padding: 12px;\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .14em;\n      font-size: 14px;\n      color: var(--muted);\n      border-bottom: 2px solid transparent\n    }\n\n    .vault-tabs button.on {\n      color: var(--gold);\n      border-bottom-color: var(--gold)\n    }\n\n    .coins {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 8px;\n      margin-bottom: 22px\n    }\n\n    .coins button {\n      padding: 9px;\n      border: 1px solid var(--line);\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      color: var(--muted);\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px)\n    }\n\n    .coins button.on {\n      border-color: var(--gold);\n      color: var(--gold)\n    }\n\n    .amt-field {\n      position: relative;\n      margin-bottom: 14px\n    }\n\n    .amt-field input {\n      width: 100%;\n      background: var(--bg);\n      border: 1px solid rgba(232, 178, 58, .5);\n      padding: 18px;\n      font-family: 'Anton', sans-serif;\n      font-size: 30px;\n      color: var(--gold);\n      outline: none;\n      clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px)\n    }\n\n    .amt-field .suf {\n      position: absolute;\n      right: 16px;\n      top: 50%;\n      transform: translateY(-50%);\n      display: flex;\n      align-items: center;\n      gap: 10px\n    }\n\n    .amt-field .suf .max {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      padding: 4px 8px;\n      border: 1px solid var(--line);\n      color: var(--muted)\n    }\n\n    .amt-field .suf .x {\n      font-family: 'Spline Sans Mono', monospace;\n      color: var(--gold)\n    }\n\n    .fee-row {\n      display: flex;\n      justify-content: space-between;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      color: var(--muted);\n      margin-bottom: 22px\n    }\n\n    .addr-box {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      background: var(--bg);\n      border: 1px solid var(--line);\n      padding: 12px 14px;\n      margin-bottom: 22px;\n      clip-path: polygon(5px 0, 100% 0, 100% 100%, 0 100%, 0 5px)\n    }\n\n    .addr-box .a {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      white-space: nowrap\n    }\n\n    .addr-box .cp {\n      margin-left: auto;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      padding: 5px 9px;\n      border: 1px solid var(--line);\n      color: var(--muted)\n    }\n\n    .vault-confirm {\n      width: 100%;\n      padding: 16px;\n      background: var(--gold);\n      color: #13182B;\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .2em;\n      font-size: 14px;\n      clip-path: polygon(8px 0, 100% 0, 100% 100%, 0 100%, 0 8px)\n    }\n\n    .vault-min {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      color: var(--muted);\n      text-align: center;\n      margin-top: 12px\n    }\n\n    /* activity */\n    .act-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 24px\n    }\n\n    .act-head h3 {\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .16em;\n      font-size: 16px\n    }\n\n    .act-head .live {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      color: var(--gold);\n      display: flex;\n      align-items: center;\n      gap: 7px\n    }\n\n    .act-head .live .dot {\n      background: var(--gold)\n    }\n\n    .timeline {\n      position: relative;\n      padding-left: 24px\n    }\n\n    .timeline .axis {\n      position: absolute;\n      left: 6px;\n      top: 6px;\n      bottom: 6px;\n      width: 2px;\n      background: linear-gradient(to bottom, var(--gold), var(--persimmon), transparent);\n      transform-origin: top;\n      transform: scaleY(0);\n      transition: transform .8s var(--ease)\n    }\n\n    .vault-pin.is-in .timeline .axis {\n      transform: scaleY(1)\n    }\n\n    .tnode {\n      position: relative;\n      margin-bottom: 22px;\n      opacity: 0;\n      transform: translateX(-16px);\n      transition: opacity .5s var(--ease), transform .5s var(--ease)\n    }\n\n    .vault-pin.is-in .tnode {\n      opacity: 1;\n      transform: translateX(0)\n    }\n\n    .vault-pin.is-in .tnode:nth-child(2) {\n      transition-delay: .1s\n    }\n\n    .vault-pin.is-in .tnode:nth-child(3) {\n      transition-delay: .2s\n    }\n\n    .vault-pin.is-in .tnode:nth-child(4) {\n      transition-delay: .3s\n    }\n\n    .vault-pin.is-in .tnode:nth-child(5) {\n      transition-delay: .4s\n    }\n\n    .tnode .dot-n {\n      position: absolute;\n      left: -23px;\n      top: 5px;\n      width: 13px;\n      height: 13px;\n      border-radius: 50%\n    }\n\n    .tnode.gold .dot-n {\n      background: var(--gold)\n    }\n\n    .tnode.per .dot-n {\n      background: var(--persimmon)\n    }\n\n    .tnode.muted .dot-n {\n      background: var(--muted)\n    }\n\n    .tnode .ttop {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 10px\n    }\n\n    .tnode .ti2 {\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      font-size: 15px;\n      letter-spacing: .04em\n    }\n\n    .tnode .tx {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      color: var(--muted);\n      margin-top: 3px\n    }\n\n    .tnode .st {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .08em;\n      text-transform: uppercase\n    }\n\n    .tnode.gold .st {\n      color: var(--gold)\n    }\n\n    .tnode.per .st {\n      color: var(--persimmon)\n    }\n\n    .tnode.muted .st {\n      color: var(--muted)\n    }\n\n    .act-stats {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n      margin-top: 24px;\n      padding-top: 20px;\n      border-top: 1px solid var(--line)\n    }\n\n    .act-stats .lab {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      color: var(--muted)\n    }\n\n    .act-stats .n {\n      font-family: 'Anton', sans-serif;\n      font-size: 22px;\n      margin-top: 4px\n    }\n\n    .act-stats .n.per {\n      color: var(--persimmon)\n    }\n\n    .act-stats .n.gold {\n      color: var(--gold)\n    }\n\n    /* =================== LEADERBOARD (#16 offset+meta-rail) =================== */\n    .lb {\n      padding: 96px 0;\n      z-index: 1;\n      border-top: 1px solid var(--line)\n    }\n\n    .podium {\n      display: grid;\n      grid-template-columns: 1fr 1.15fr 1fr;\n      gap: 18px;\n      max-width: 860px;\n      margin: 0 auto 46px;\n      align-items: end\n    }\n\n    .pcol {\n      text-align: center;\n      position: relative;\n      opacity: 0;\n      transform: translateY(40px);\n      transition: opacity .8s var(--ease), transform .8s var(--ease)\n    }\n\n    .lb.is-in .pcol {\n      opacity: 1;\n      transform: translateY(0)\n    }\n\n    .lb.is-in .pcol:nth-child(1) {\n      transition-delay: .12s\n    }\n\n    .lb.is-in .pcol:nth-child(2) {\n      transition-delay: 0s\n    }\n\n    .lb.is-in .pcol:nth-child(3) {\n      transition-delay: .24s\n    }\n\n    .crest {\n      margin: 0 auto;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: var(--panel)\n    }\n\n    .crest.s {\n      width: 78px;\n      height: 78px\n    }\n\n    .crest.l {\n      width: 108px;\n      height: 108px\n    }\n\n    .crest.gold {\n      border: 1px solid rgba(232, 178, 58, .6)\n    }\n\n    .crest.per {\n      border: 1px solid rgba(255, 90, 44, .55)\n    }\n\n    .crest.line {\n      border: 1px solid var(--line-2)\n    }\n\n    .pcol .handle {\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      font-size: 15px;\n      margin-top: 12px;\n      letter-spacing: .04em\n    }\n\n    .pcol .win {\n      font-family: 'Anton', sans-serif;\n      font-size: 20px;\n      margin-top: 4px\n    }\n\n    .pcol.r1 .win {\n      color: var(--gold);\n      font-size: 26px\n    }\n\n    .pcol.r2 .win {\n      color: var(--ink)\n    }\n\n    .pcol.r3 .win {\n      color: var(--persimmon)\n    }\n\n    .plinth {\n      margin-top: 14px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n      clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);\n      background: var(--panel);\n      border: 1px solid var(--line-2)\n    }\n\n    .pcol.r1 .plinth {\n      height: 166px;\n      border-color: rgba(232, 178, 58, .6)\n    }\n\n    .pcol.r2 .plinth {\n      height: 118px\n    }\n\n    .pcol.r3 .plinth {\n      height: 90px;\n      border-color: rgba(255, 90, 44, .55)\n    }\n\n    .plinth .rk {\n      font-family: 'Anton', sans-serif;\n      font-size: 46px;\n      color: var(--muted)\n    }\n\n    .pcol.r1 .plinth .rk {\n      color: var(--gold)\n    }\n\n    .pcol.r3 .plinth .rk {\n      color: var(--persimmon)\n    }\n\n    .vip {\n      position: absolute;\n      top: 8px;\n      right: 8px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      color: var(--gold)\n    }\n\n    .crown {\n      position: absolute;\n      top: -26px;\n      left: 50%;\n      transform: translateX(-50%);\n      color: var(--gold)\n    }\n\n    .lb-table {\n      max-width: 920px;\n      margin: 0 auto\n    }\n\n    .lb-th {\n      display: grid;\n      grid-template-columns: 48px 1fr 150px 90px 110px;\n      gap: 12px;\n      padding: 8px 16px;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 11px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      color: var(--muted)\n    }\n\n    .lb-th .r {\n      text-align: right\n    }\n\n    .lb-row {\n      position: relative;\n      display: grid;\n      grid-template-columns: 48px 1fr 150px 90px 110px;\n      gap: 12px;\n      align-items: center;\n      padding: 13px 16px;\n      border: 1px solid var(--line-2);\n      background: rgba(27, 33, 56, .5);\n      margin-bottom: 8px;\n      clip-path: polygon(6px 0, 100% 0, 100% 100%, 0 100%, 0 6px);\n      transition: border-color .25s;\n      opacity: 0;\n      transform: translateX(-18px)\n    }\n\n    .lb.is-in .lb-row {\n      opacity: 1;\n      transform: translateX(0);\n      transition: opacity .55s var(--ease), transform .55s var(--ease), border-color .25s\n    }\n\n    .lb.is-in .lb-row:nth-child(2) {\n      transition-delay: .06s\n    }\n\n    .lb.is-in .lb-row:nth-child(3) {\n      transition-delay: .12s\n    }\n\n    .lb.is-in .lb-row:nth-child(4) {\n      transition-delay: .18s\n    }\n\n    .lb.is-in .lb-row:nth-child(5) {\n      transition-delay: .24s\n    }\n\n    .lb.is-in .lb-row:nth-child(6) {\n      transition-delay: .30s\n    }\n\n    .lb.is-in .lb-row:nth-child(7) {\n      transition-delay: .36s\n    }\n\n    .lb.is-in .lb-row:nth-child(8) {\n      transition-delay: .42s\n    }\n\n    .lb-row:hover {\n      border-color: var(--gold)\n    }\n\n    .lb-row .rk {\n      font-family: 'Spline Sans Mono', monospace;\n      color: var(--muted);\n      font-size: 13px\n    }\n\n    .lb-row .hd {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      font-family: 'Anton', sans-serif;\n      text-transform: uppercase;\n      letter-spacing: .04em;\n      font-size: 15px\n    }\n\n    .lb-row .game {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      color: var(--muted)\n    }\n\n    .lb-row .spins {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px\n    }\n\n    .lb-row .winn {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 13px;\n      color: var(--gold);\n      text-align: right\n    }\n\n    /* vertical meta-rail outside left edge */\n    .lb-row .rail {\n      position: absolute;\n      left: -1px;\n      top: 0;\n      bottom: 0;\n      width: 3px;\n      background: var(--gold);\n      transform: scaleY(0);\n      transform-origin: top;\n      transition: transform .4s var(--ease)\n    }\n\n    .lb.is-in .lb-row.shown .rail {\n      transform: scaleY(1)\n    }\n\n    .crest-svg {\n      width: 60%;\n      height: 60%\n    }\n\n    /* =================== FOOTER =================== */\n    footer {\n      position: relative;\n      z-index: 1;\n      border-top: 1px solid var(--line);\n      background: rgba(27, 33, 56, .6)\n    }\n\n    .foot-seam {\n      height: 2px;\n      background: linear-gradient(90deg, transparent, var(--gold), transparent);\n      transform: scaleX(0);\n      transform-origin: center;\n      transition: transform .9s var(--ease)\n    }\n\n    footer.is-in .foot-seam {\n      transform: scaleX(1)\n    }\n\n    .foot-grid {\n      display: grid;\n      grid-template-columns: 2fr 1fr 1fr;\n      gap: 40px;\n      padding: 56px 0\n    }\n\n    .foot-col {\n      opacity: 0;\n      transform: translateY(22px);\n      transition: opacity .6s var(--ease), transform .6s var(--ease)\n    }\n\n    footer.is-in .foot-col {\n      opacity: 1;\n      transform: translateY(0)\n    }\n\n    footer.is-in .foot-col:nth-child(2) {\n      transition-delay: .1s\n    }\n\n    footer.is-in .foot-col:nth-child(3) {\n      transition-delay: .2s\n    }\n\n    .foot-col .logo {\n      font-size: 24px;\n      margin-bottom: 14px\n    }\n\n    .foot-col p {\n      color: var(--muted);\n      font-size: 14px;\n      max-width: 54ch;\n      line-height: 1.6\n    }\n\n    .foot-badges {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      margin-top: 18px\n    }\n\n    .foot-badges .chip.g {\n      border-color: rgba(232, 178, 58, .5);\n      color: var(--gold)\n    }\n\n    .foot-badges .chip.p {\n      border-color: rgba(255, 90, 44, .5);\n      color: var(--persimmon)\n    }\n\n    .foot-col h5 {\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n      color: var(--muted);\n      margin-bottom: 16px\n    }\n\n    .foot-col ul {\n      list-style: none\n    }\n\n    .foot-col li {\n      margin-bottom: 11px;\n      font-size: 14px\n    }\n\n    .foot-col a:hover {\n      color: var(--gold)\n    }\n\n    .foot-col li .d {\n      color: var(--persimmon)\n    }\n\n    .foot-bottom {\n      border-top: 1px solid var(--line);\n      padding: 18px 0;\n      text-align: center;\n      font-family: 'Spline Sans Mono', monospace;\n      font-size: 12px;\n      color: var(--muted)\n    }\n\n    /* =================== RESPONSIVE =================== */\n    @media (max-width:1080px) {\n\n      /* drop the pin below 1080: hero flows normally, deck becomes a vertical list */\n      .hero-outer {\n        height: auto\n      }\n\n      .hero {\n        position: static;\n        height: auto;\n        display: block;\n        overflow: visible;\n        padding: 54px 0 80px\n      }\n\n      .hero-grid {\n        grid-template-columns: 1fr;\n        gap: 60px\n      }\n\n      .stack-zone {\n        order: 2;\n        gap: 30px\n      }\n\n      .stack {\n        height: auto;\n        width: 100%;\n        max-width: 340px;\n        aspect-ratio: auto\n      }\n\n      .card {\n        position: relative;\n        inset: auto;\n        width: 100%;\n        aspect-ratio: 300/418;\n        transform: none !important;\n        opacity: 1 !important;\n        margin-bottom: 16px;\n        box-shadow: 0 18px 40px -22px rgba(0, 0, 0, .7)\n      }\n\n      .deck-prog {\n        display: none\n      }\n\n      .ledger {\n        position: static;\n        transform: none;\n        flex-direction: row;\n        flex-wrap: wrap;\n        gap: 24px;\n        margin-top: 34px;\n        justify-content: center\n      }\n\n      .lobby-layout {\n        grid-template-columns: 1fr\n      }\n\n      .aside {\n        position: static\n      }\n\n      .pf-grid {\n        grid-template-columns: 1fr;\n        gap: 34px\n      }\n    }\n\n    @media (max-width:768px) {\n      .wrap {\n        padding: 0 18px\n      }\n\n      .hd-nav,\n      .hd-tick {\n        display: none\n      }\n\n      .hero {\n        padding: 36px 0 70px\n      }\n\n      .hero-top {\n        margin-bottom: 30px\n      }\n\n      .spine {\n        display: none\n      }\n\n      .stack {\n        width: 100%;\n        max-width: 300px\n      }\n\n      .tile.feat {\n        grid-column: span 12;\n        grid-row: auto;\n        min-height: 280px\n      }\n\n      .tile.med {\n        grid-column: span 6;\n        min-height: 160px\n      }\n\n      .tile.sm {\n        grid-column: span 6;\n        min-height: 140px\n      }\n\n      /* drop pins on mobile — show as normal vertical scroll */\n      .pf-outer {\n        height: auto\n      }\n\n      .pf-pin {\n        position: static;\n        height: auto;\n        display: block;\n        padding: 60px 0\n      }\n\n      .pf-panels {\n        position: static;\n        min-height: 0;\n        margin-top: 24px\n      }\n\n      .pf-panel {\n        position: static;\n        opacity: 1;\n        transform: none;\n        pointer-events: auto;\n        margin-bottom: 18px\n      }\n\n      .pf-progress {\n        display: none\n      }\n\n      .vault-outer {\n        height: auto\n      }\n\n      .vault-pin {\n        position: static;\n        height: auto;\n        display: block;\n        padding: 60px 0\n      }\n\n      .vault-stack {\n        position: static;\n        min-height: 0\n      }\n\n      .vpanel {\n        position: static;\n        transform: none !important;\n        opacity: 1 !important;\n        margin-bottom: 18px\n      }\n\n      .podium {\n        grid-template-columns: 1fr;\n        max-width: 340px\n      }\n\n      .lb-th {\n        display: none\n      }\n\n      .lb-row {\n        grid-template-columns: 36px 1fr auto;\n        gap: 8px\n      }\n\n      .lb-row .game,\n      .lb-row .spins {\n        display: none\n      }\n\n      .foot-grid {\n        grid-template-columns: 1fr;\n        gap: 30px\n      }\n    }\n  </style>\n<link     href=\"https://fonts.googleapis.com/css2?family=Anton&family=Spline+Sans:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600&display=swap\"\n    rel=\"stylesheet\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n\n  <div class=\"la