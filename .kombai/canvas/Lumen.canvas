e {\n      display: flex;\n      flex-direction: column;\n      gap: 0.5rem;\n    }\n\n    .principle-number {\n      font-family: var(--font-display);\n      font-size: 56px;\n      font-weight: 400;\n      font-style: italic;\n      line-height: 1;\n      color: var(--accent);\n      margin: 0 0 0.5rem;\n    }\n\n    .principle-title {\n      display: inline;\n      font-size: 24px;\n      font-weight: 500;\n      line-height: 1.25;\n      letter-spacing: -0.01em;\n      color: var(--fg);\n      margin: 0;\n      background-image: linear-gradient(var(--accent), var(--accent));\n      background-repeat: no-repeat;\n      background-position: 0 100%;\n      background-size: 0% 1px;\n      padding-bottom: 3px;\n      transition: background-size 420ms var(--ease);\n    }\n\n    .principle:hover .principle-title { background-size: 100% 1px; }\n\n    .principle-desc {\n      font-size: 16px;\n      font-weight: 400;\n      line-height: 1.55;\n      color: var(--fg-muted);\n      margin: 0.5rem 0 0;\n      max-width: 36ch;\n    }\n\n    .principle-detail { margin-top: 1.25rem; display: flex; gap: 8px; }\n    .tag {\n      display: inline-flex;\n      padding: 4px 10px;\n      border-radius: 4px;\n      background: rgba(255, 255, 255, 0.04);\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      font-size: 12.5px;\n      color: var(--fg-muted);\n    }\n\n    .tag-minimal {\n      display: inline-flex;\n      padding: 0;\n      background: transparent;\n      border: none;\n      font-size: 12.5px;\n      color: var(--fg-muted);\n      margin-left: 6px;\n    }\n\n    .shorthand-row { display: flex; align-items: center; gap: 10px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; }\n    .shorthand-key { color: var(--accent); background: rgba(249, 115, 22, 0.08); padding: 2px 8px; border-radius: 4px; }\n    .shorthand-val { color: var(--fg-muted); }\n\n    .product-header { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 