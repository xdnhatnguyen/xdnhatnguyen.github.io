        "head": "<meta charset=\"utf-8\" >\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" >\n  <title>AI that lives on your desktop.</title>\n  <meta name=\"description\" content=\"Lives where you work. Sees what you see. Acts when you ask.\" >\n\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"  onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin  onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <link rel=\"preconnect\" href=\"https://prod.spline.design\" crossorigin  onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <link rel=\"preconnect\" href=\"https://unpkg.com\" crossorigin  onerror=\"__crawlAsset&&__crawlAsset(this)\">"
