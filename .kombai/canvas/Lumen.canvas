     Location\n                    </span>\n                    <span class=\"value\" data-kid=\"4-1-1-2-1-2\" data-name=\"location value\">\n                        Ho Chi Minh City, Vietnam\n                    </span>\n                </div>\n                <div class=\"contact-item\" data-kid=\"4-1-1-2-2\" data-name=\"github contact item\">\n                    <span class=\"label\" data-kid=\"4-1-1-2-2-1\" data-name=\"github label\">\n                        GitHub\n                    </span>\n                    <a class=\"value\" data-kid=\"4-1-1-2-2-2\" data-name=\"github value\" href=\"https://github.com/xdnhatnguyen\" style=\"display: inline-flex; align-items: center; gap: 4px;\">\n                        xdnhatnguyen\n                        <svg data-kid=\"4-1-1-2-2-2-1\" data-name=\"external link icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"12\">\n                            <path d=\"M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6m4-3h6m0 0v6m0-6L10 14\">\n                            </path>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"contact-item\" data-kid=\"4-1-1-2-3\" data-name=\"email contact item\">\n                    <span class=\"label\" data-kid=\"4-1-1-2-3-1\" data-name=\"email label\">\n                        Email\n                    </span>\n                    <a class=\"value\" data-kid=\"4-1-1-2-3-2\" data-name=\"email value\" href=\"mailto:hello@nhat.me\">\n                        hello@nhat.me\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"sidebar-section\" data-kid=\"4-1-2\" data-name=\"focus section\">\n            <h3 data-kid=\"4-1-2-1\" data-name=\"focus section title\">\n                Focus\n            </h3>\n            <div class=\"tag-cloud\" data-kid=\"4-1-2-2\" data-name=\"focus tag cloud\">\n                <span class=\"tag highlight\" data-kid=\"4-1-2-2-1\" data-name=\"highlighted computer vision tag\">\n                    computer vision\n                </span>\n                <span class=\"tag\" data-kid=\"4-1-2-2-2\" data-name=\"diffusion models tag\">\n                    diffusion models\n                </span>\n                <span class=\"tag\" data-kid=\"4-1-2-2-3\" data-name=\"calculus tag\">\n                    calculus\n                </span>\n                <span class=\"tag\" data-kid=\"4-1-2-2-4\" data-name=\"open source tag\">\n                    open source\n                </span>\n                <span class=\"tag\" data-kid=\"4-1-2-2-5\" data-name=\"stochastic processes tag\">\n                    stochastic processes\n                </span>\n            </div>\n        </section>\n        <section class=\"sidebar-section\" data-kid=\"4-1-3\" data-name=\"tooling section\">\n            <h3 data-kid=\"4-1-3-1\" data-name=\"tooling section title\">\n                Tooling\n            </h3>\n            <div class=\"tool-grid\" data-kid=\"4-1-3-2\" data-name=\"tool grid\">\n                <div class=\"tool-item\" data-kid=\"4-1-3-2-1\" data-name=\"python tool item\">\n                    <div class=\"tool-dot\" data-kid=\"4-1-3-2-1-1\" data-name=\"tool dot\">\n                    </div>\n                    Python\n                </div>\n                <div class=\"tool-item\" data-kid=\"4-1-3-2-2\" data-name=\"pytorch tool item\">\n                    <div class=\"tool-dot\" data-kid=\"4-1-3-2-2-1\" data-name=\"tool dot\">\n                    </div>\n                    PyTorch\n                </div>\n                <div class=\"tool-item\" data-kid=\"4-1-3-2-3\" data-name=\"jekyll tool item\">\n                    <div class=\"tool-dot\" data-kid=\"4-1-3-2-3-1\" data-name=\"tool dot\">\n                    </div>\n                    Jekyll\n                </div>\n                <div class=\"tool-item\" data-kid=\"4-1-3-2-4\" data-name=\"liquid tool item\">\n                    <div class=\"tool-dot\" data-kid=\"4-1-3-2-4-1\" data-name=\"tool dot\">\n                    </div>\n                    Liquid\n                </div>\n                <div class=\"tool-item\" data-kid=\"4-1-3-2-5\" data-name=\"latex tool item\">\n                    <div class=\"tool-dot\" data-kid=\"4-1-3-2-5-1\" data-name=\"tool dot\">\n                    </div>\n                    LaTeX\n                </div>\n                <div class=\"tool-item\" data-kid=\"4-1-3-2-6\" data-name=\"git tool item\">\n                    <div class=\"tool-dot\" data-kid=\"4-1-3-2-6-1\" data-name=\"tool dot\">\n                    </div>\n                    Git\n                </div>\n            </div>\n        </section>\n    </aside>\n    <div class=\"cv-content\" data-kid=\"4-2\" data-name=\"cv content column\">\n        <section class=\"content-section reveal\" data-kid=\"4-2-1\" data-name=\"education section\">\n            <span class=\"section-marginal\" data-kid=\"4-2-1-1\" data-name=\"education section label\">\n                01\n            </span>\n            <h2 data-kid=\"4-2-1-2\" data-name=\"education section heading\">\n                Education\n            </h2>\n            <div class=\"timeline\" data-kid=\"4-2-1-3\" data-name=\"education timeline\">\n                <div class=\"timeline-item\" data-kid=\"4-2-1-3-1\" data-name=\"education timeline item\">\n                    <div class=\"timeline-dot\" data-kid=\"4-2-1-3-1-1\" data-name=\"timeline dot\">\n                    </div>\n                    <div class=\"timeline-header\" data-kid=\"4-2-1-3-1-2\" data-name=\"timeline header\">\n                        <span class=\"timeline-title\" data-kid=\"4-2-1-3-1-2-1\" data-name=\"education degree title\">\n                            VNU-HCM University of Science\n                        </span>\n                        <span class=\"timeline-date\" data-kid=\"4-2-1-3-1-2-2\" data-name=\"education date\">\n                            2025—Present\n                        </span>\n                    </div>\n                    <div class=\"timeline-org\" data-kid=\"4-2-1-3-1-3\" data-name=\"education institution org\">\n                        Information Technology\n                    </div>\n                    <p class=\"timeline-desc\" data-kid=\"4-2-1-3-1-4\" data-name=\"education description\">\n                        Current undergraduate student focused on the intersection of mathematics and machine learning. \n                        Engaging in early-stage research into computer vision architectures.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"content-section reveal\" data-kid=\"4-2-2\" data-name=\"research direction section\">\n            <span class=\"section-marginal\" data-kid=\"4-2-2-1\" data-name=\"research section label\">\n                02\n            </span>\n            <h2 data-kid=\"4-2-2-2\" data-name=\"research section heading\">\n                Research direction\n            </h2>\n            <div class=\"timeline\" data-kid=\"4-2-2-3\" data-name=\"research timeline\">\n                <div class=\"timeline-item\" data-kid=\"4-2-2-3-1\" data-name=\"research timeline item\">\n                    <div class=\"timeline-dot\" data-kid=\"4-2-2-3-1-1\" data-name=\"timeline dot\">\n                    </div>\n                    <div class=\"timeline-header\" data-kid=\"4-2-2-3-1-2\" data-name=\"research header\">\n                        <span class=\"timeline-title\" data-kid=\"4-2-2-3-1-2-1\" data-name=\"research area title\">\n                            Core Interests\n                        </span>\n                        <span class=\"timeline-date\" data-kid=\"4-2-2-3-1-2-2\" data-name=\"research status date\">\n                            Current Focus\n                        </span>\n                    </div>\n                    <div class=\"timeline-org\" data-kid=\"4-2-2-3-1-3\" data-name=\"research organization\">\n                        Generative Models · SDEs · CV\n                    </div>\n                    <p class=\"timeline-desc\" data-kid=\"4-2-2-3-1-4\" data-name=\"research description\">\n                        Exploring generative modeling through the lens of stochastic differential equations and \n                        optimization theory. Aspiring to bridge theoretical calculus with practical computer vision applications.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"content-section reveal\" data-kid=\"4-2-3\" data-name=\"selected work section\">\n            <span class=\"section-marginal\" data-kid=\"4-2-3-1\" data-name=\"work section label\">\n                03\n            </span>\n            <h2 data-kid=\"4-2-3-2\" data-name=\"work section heading\">\n                Selected work\n            </h2>\n            <div class=\"timeline\" data-kid=\"4-2-3-3\" data-name=\"work timeline\">\n                <div class=\"timeline-item\" data-kid=\"4-2-3-3-1\" data-name=\"work timeline item\">\n                    <div class=\"timeline-dot\" data-kid=\"4-2-3-3-1-1\" data-name=\"timeline dot\">\n                    </div>\n                    <div class=\"timeline-header\" data-kid=\"4-2-3-3-1-2\" data-name=\"work header\">\n                        <span class=\"timeline-title\" data-kid=\"4-2-3-3-1-2-1\" data-name=\"work project title\">\n                            Digits Classification Project\n                        </span>\n                        <span class=\"timeline-date\" data-kid=\"4-2-3-3-1-2-2\" data-name=\"work project date\">\n                            2025\n                        </span>\n                    </div>\n                    <div class=\"timeline-org\" data-kid=\"4-2-3-3-1-3\" data-name=\"work project role\">\n                        CNN vs. MLP Benchmark\n                    </div>\n                    <p class=\"timeline-desc\" data-kid=\"4-2-3-3-1-4\" data-name=\"work description\">\n                        A detailed comparative study analyzing spatial feature extraction efficiency across different \n                        neural architectures. Implemented from scratch using PyTorch.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"content-section reveal\" data-kid=\"4-2-4\" data-name=\"writing section\">\n            <span class=\"section-marginal\" data-kid=\"4-2-4-1\" data-name=\"writing section label\">\n                04\n            </span>\n            <h2 data-kid=\"4-2-4-2\" data-name=\"writing section heading\">\n                Writing\n            </h2>\n            <div class=\"writing-list\" data-kid=\"4-2-4-3\" data-name=\"writing articles list\">\n                <a class=\"writing-card\" data-kid=\"4-2-4-3-1\" data-name=\"first article card\" href=\"#\">\n                    <div data-kid=\"4-2-4-3-1-1\" data-name=\"article content container\">\n                        <span class=\"title\" data-kid=\"4-2-4-3-1-1-1\" data-name=\"article title\">\n                            Calculus 2 Notes\n                        </span>\n                        <span class=\"meta\" data-kid=\"4-2-4-3-1-1-2\" data-name=\"article category\">\n                            Mathematics\n                        </span>\n                    </div>\n                    <span class=\"date\" data-kid=\"4-2-4-3-1-2\" data-name=\"article date\">\n                        2026\n                    </span>\n                </a>\n                <a class=\"writing-card\" data-kid=\"4-2-4-3-2\" data-name=\"second article card\" href=\"#\">\n                    <div data-kid=\"4-2-4-3-2-1\" data-name=\"article content container\">\n                        <span class=\"title\" data-kid=\"4-2-4-3-2-1-1\" data-name=\"article title\">\n                            Intro to Optimal Control\n                        </span>\n                        <span class=\"meta\" data-kid=\"4-2-4-3-2-1-2\" data-name=\"article category\">\n                            Systems & Optimization\n                        </span>\n                    </div>\n                    <span class=\"date\" data-kid=\"4-2-4-3-2-2\" data-name=\"article date\">\n                        2026\n                    </span>\n                </a>\n                <a class=\"writing-card\" data-kid=\"4-2-4-3-3\" data-name=\"third article card\" href=\"#\">\n                    <div data-kid=\"4-2-4-3-3-1\" data-name=\"article content container\">\n                        <span class=\"title\" data-kid=\"4-2-4-3-3-1-1\" data-name=\"article title\">\n                            Differential Equations\n                        </span>\n                        <span class=\"meta\" data-kid=\"4-2-4-3-3-1-2\" data-name=\"article category\">\n                            Calculus Foundations\n                        </span>\n                    </div>\n                    <span class=\"date\" data-kid=\"4-2-4-3-3-2\" data-name=\"article date\">\n                        2025\n                    </span>\n                </a>\n                <a class=\"writing-card\" data-kid=\"4-2-4-3-4\" data-name=\"fourth article card\" href=\"#\">\n                    <div data-kid=\"4-2-4-3-4-1\" data-name=\"article content container\">\n                        <span class=\"title\" data-kid=\"4-2-4-3-4-1-1\" data-name=\"article title\">\n                            Stochastic Processes\n                        </span>\n                        <span class=\"meta\" data-kid=\"4-2-4-3-4-1-2\" data-name=\"article category\">\n                            Probability Theory\n                        </span>\n                    </div>\n                    <span class=\"date\" data-kid=\"4-2-4-3-4-2\" data-name=\"article date\">\n                        2025\n                    </span>\n                </a>\n            </div>\n        </section>\n    </div>\n</main>\n<footer class=\"cv-footer reveal\" data-kid=\"5\" data-name=\"footer area\">\n    <div class=\"footer-note\" data-kid=\"5-1\" data-name=\"footer note text\">\n        Rendered from\n        <code data-kid=\"5-1-1\" data-name=\"filename code block\">\n            _data/cv.yml\n        </code>\n        · Available as\n        <a class=\"nav-link\" data-kid=\"5-1-2\" data-name=\"rendercv link\" href=\"#\" style=\"text-decoration: underline;\">\n            RenderCV\n        </a>\n        or\n        <a class=\"nav-link\" data-kid=\"5-1-3\" data-name=\"jsonresume link\" href=\"#\" style=\"text-decoration: underline;\">\n            JSONResume\n        </a>\n        .\n    </div>\n    <div class=\"footer-stamp\" data-kid=\"5-2\" data-name=\"footer update timestamp\">\n        Last updated January 2026\n    </div>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    window.addEventListener('DOMContentLoaded', () => {\n        // Entrance animations\n        gsap.to('.reveal', {\n            opacity: 1,\n            y: 0,\n            duration: 1.2,\n            stagger: 0.1,\n            ease: \"expo.out\",\n            scrollTrigger: {\n                trigger: '.reveal',\n                start: 'top 90%',\n            }\n        });\n\n        // Sticky nav transition\n        const nav = document.querySelector('.nav');\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > 50) {\n                nav.style.height = '56px';\n                nav.style.background = 'rgba(13, 10, 8, 0.95)';\n            } else {\n                nav.style.height = '64px';\n                nav.style.background = 'rgba(13, 10, 8, 0.85)';\n            }\n        });\n    });\n</script>\n",
