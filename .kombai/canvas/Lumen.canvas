    "var_51769bf4f998": {
      "type": "variant",
      "label": "CV — Academic Profile",
      "parentId": "var_ef18b89d8526",
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Serif:ital,wght@0,400;1,400&display=swap');\n\n    :root {\n        --bg: #0d0a08;\n        --surface: #14110d;\n        --fg: #fafafa;\n        --fg-muted: rgba(250, 250, 250, 0.55);\n        --accent: #f97316;\n        --border: rgba(250, 250, 250, 0.12);\n        --border-strong: rgba(250, 250, 250, 0.2);\n        --font-body: 'DM Sans', sans-serif;\n        --font-display: 'Instrument Serif', serif;\n        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);\n        --pad-x: 2rem;\n    }\n\n    @media (min-width: 1024px) {\n        :root {\n            --pad-x: 5rem;\n        }\n    }\n\n    body {\n        background-color: var(--bg);\n        color: var(--fg);\n        font-family: var(--font-body);\n        line-height: 1.6;\n        overflow-x: clip;\n        -webkit-font-smoothing: antialiased;\n        -moz-osx-font-smoothing: grayscale;\n    }\n\n    .grain {\n        position: fixed;\n        inset: 0;\n        z-index: 999;\n        pointer-events: none;\n        opacity: 0.04;\n        background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    }\n\n    /* Navigation */\n    .nav {\n        position: sticky;\n        top: 0;\n        z-index: 100;\n        background: rgba(13, 10, 8, 0.85);\n        backdrop-filter: blur(12px);\n        border-bottom: 1px solid var(--border);\n        height: 64px;\n        display: flex;\n        align-items: center;\n        padding: 0 var(--pad-x);\n    }\n\n    .nav-container {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        width: 100%;\n        max-width: 1200px;\n        margin: 0 auto;\n    }\n\n    .nav-brand {\n        font-weight: 500;\n        text-decoration: none;\n        color: var(--fg);\n        font-size: 15px;\n        display: flex;\n        align-items: center;\n        gap: 8px;\n    }\n\n    .nav-brand-dot {\n        width: 8px;\n        height: 8px;\n        background: var(--accent);\n        border-radius: 50%;\n    }\n\n    .nav-links {\n        display: none;\n        gap: 1.5rem;\n    }\n\n    @media (min-width: 768px) {\n        .nav-links {\n            display: flex;\n        }\n    }\n\n    .nav-link {\n        text-decoration: none;\n        color: var(--fg-muted);\n        font-size: 14px;\n        transition: color 0.3s var(--ease-out);\n    }\n\n    .nav-link:hover, .nav-link.active {\n        color: var(--fg);\n    }\n\n    .nav-link.active {\n        color: var(--accent);\n    }\n\n    /* Header */\n    .cv-header {\n        padding: 8rem var(--pad-x) 6rem;\n        max-width: 1200px;\n        margin: 0 auto;\n        position: relative;\n    }\n\n    .header-eyebrow {\n        font-size: 12px;\n        font-weight: 500;\n        letter-spacing: 0.2em;\n        text-transform: uppercase;\n        color: var(--fg-muted);\n        margin-bottom: 1rem;\n        display: block;\n    }\n\n    h1 {\n        font-family: var(--font-display);\n        font-size: clamp(64px, 10vw, 120px);\n        font-weight: 400;\n        line-height: 0.9;\n        margin: 0;\n        letter-spacing: -0.04em;\n    }\n\n    .header-content {\n        margin-top: 3rem;\n        display: grid;\n        grid-template-columns: 1fr;\n        gap: 2rem;\n        border-bottom: 1px solid var(--border);\n        padding-bottom: 4rem;\n    }\n\n    @media (min-width: 1024px) {\n        .header-content {\n            grid-template-columns: 1fr 1.5fr;\n            align-items: end;\n        }\n    }\n\n    .header-intro {\n        max-width: 500px;\n    }\n\n    .header-name {\n        font-size: 24px;\n        font-weight: 500;\n        margin-bottom: 0.5rem;\n    }\n\n    .header-role {\n        font-size: 18px;\n        color: var(--accent);\n        margin-bottom: 1.5rem;\n    }\n\n    .header-desc {\n        font-size: 18px;\n        color: var(--fg-muted);\n        line-height: 1.5;\n    }\n\n    .header-actions {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 1rem;\n        align-items: center;\n    }\n\n    .btn {\n        display: inline-flex;\n        align-items: center;\n        gap: 10px;\n        padding: 12px 24px;\n        border-radius: 4px;\n        font-size: 14px;\n        font-weight: 500;\n        text-decoration: none;\n        transition: all 0.3s var(--ease-out);\n    }\n\n    .btn-primary {\n        background: var(--accent);\n        color: var(--bg);\n    }\n\n    .btn-primary:hover {\n        transform: translateY(-2px);\n        filter: brightness(1.1);\n        box-shadow: 0 10px 20px -10px rgba(249, 115, 22, 0.3);\n    }\n\n    .btn-outline {\n        border: 1px solid var(--border-strong);\n        color: var(--fg);\n    }\n\n    .btn-outline:hover {\n        background: rgba(255,255,255,0.05);\n        border-color: var(--fg);\n    }\n\n    .cv-format-tag {\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-size: 11px;\n        color: var(--fg-muted);\n        opacity: 0.5;\n        height: 40px;\n        display: flex;\n        align-items: center;\n    }\n\n    /* Main Grid */\n    .cv-main {\n        padding: 4rem var(--pad-x) 8rem;\n        max-width: 1200px;\n        margin: 0 auto;\n        display: grid;\n        grid-template-columns: 1fr;\n        gap: 4rem;\n    }\n\n    @media (min-width: 1024px) {\n        .cv-main {\n            grid-template-columns: 300px 1fr;\n            gap: 6rem;\n        }\n    }\n\n    /* Sidebar Column */\n    .cv-sidebar {\n        display: flex;\n        flex-direction: column;\n        gap: 4rem;\n        border-right: 1px solid var(--border);\n        padding-right: 2rem;\n    }\n\n    @media (max-width: 1023px) {\n        .cv-sidebar {\n            border-right: none;\n            padding-right: 0;\n            border-bottom: 1px solid var(--border);\n            padding-bottom: 4rem;\n        }\n    }\n\n    .sidebar-section h3 {\n        font-size: 11px;\n        font-weight: 600;\n        text-transform: uppercase;\n        letter-spacing: 0.15em;\n        color: var(--fg-muted);\n        margin-bottom: 1.5rem;\n        display: flex;\n        align-items: center;\n        gap: 12px;\n    }\n\n    .sidebar-section h3::after {\n        content: '';\n        flex: 1;\n        height: 1px;\n        background: var(--border);\n    }\n\n    .contact-list {\n        display: flex;\n        flex-direction: column;\n        gap: 1.5rem;\n    }\n\n    .contact-item .label {\n        font-size: 12px;\n        color: var(--fg-muted);\n        display: block;\n        margin-bottom: 0.25rem;\n    }\n\n    .contact-item .value {\n        font-size: 15px;\n        color: var(--fg);\n        text-decoration: none;\n        transition: color 0.3s var(--ease-out);\n    }\n\n    .contact-item a.value:hover {\n        color: var(--accent);\n    }\n\n    .tag-cloud {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 8px;\n    }\n\n    .tag {\n        font-size: 13px;\n        padding: 6px 12px;\n        background: var(--surface);\n        border: 1px solid var(--border);\n        border-radius: 4px;\n        color: var(--fg-muted);\n        transition: all 0.3s var(--ease-out);\n    }\n\n    .tag:hover {\n        border-color: var(--accent);\n        color: var(--fg);\n    }\n\n    .tag.highlight {\n        border-color: rgba(249, 115, 22, 0.3);\n        color: var(--accent);\n    }\n\n    .tool-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 0.75rem;\n    }\n\n    .tool-item {\n        font-size: 14px;\n        color: var(--fg-muted);\n        display: flex;\n        align-items: center;\n        gap: 8px;\n    }\n\n    .tool-dot {\n        width: 4px;\n        height: 4px;\n        background: var(--accent);\n        border-radius: 50%;\n    }\n\n    /* Content Column */\n    .cv-content {\n        display: flex;\n        flex-direction: column;\n        gap: 6rem;\n    }\n\n    .content-section {\n        position: relative;\n    }\n\n    .section-marginal {\n        position: absolute;\n        left: -4rem;\n        top: 8px;\n        font-size: 11px;\n        font-weight: 500;\n        color: var(--accent);\n        opacity: 0.7;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n    }\n\n    @media (max-width: 1023px) {\n        .section-marginal {\n            position: static;\n            display: block;\n            margin-bottom: 1rem;\n        }\n    }\n\n    .content-section h2 {\n        font-family: var(--font-display);\n        font-size: 32px;\n        font-weight: 400;\n        margin: 0 0 2.5rem 0;\n        letter-spacing: -0.01em;\n    }\n\n    .timeline {\n        border-left: 1px solid var(--border);\n        padding-left: 2rem;\n        margin-left: 0.5rem;\n    }\n\n    .timeline-item {\n        position: relative;\n        margin-bottom: 3.5rem;\n    }\n\n    .timeline-item:last-child {\n        margin-bottom: 0;\n    }\n\n    .timeline-dot {\n        position: absolute;\n        left: calc(-2rem - 5px);\n        top: 10px;\n        width: 9px;\n        height: 9px;\n        background: var(--accent);\n        border-radius: 50%;\n        border: 2px solid var(--bg);\n        transition: transform 0.3s var(--ease-out);\n    }\n\n    .timeline-item:hover .timeline-dot {\n        transform: scale(1.4);\n    }\n\n    .timeline-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: baseline;\n        gap: 1rem;\n        margin-bottom: 0.5rem;\n    }\n\n    .timeline-title {\n        font-size: 18px;\n        font-weight: 600;\n        color: var(--fg);\n    }\n\n    .timeline-date {\n        font-size: 13px;\n        color: var(--fg-muted);\n        font-variant-numeric: tabular-nums;\n        white-space: nowrap;\n    }\n\n    .timeline-org {\n        font-size: 15px;\n        color: var(--accent);\n        margin-bottom: 1rem;\n    }\n\n    .timeline-desc {\n        font-size: 16px;\n        line-height: 1.6;\n        color: var(--fg-muted);\n        max-width: 65ch;\n    }\n\n    .writing-list {\n        display: flex;\n        flex-direction: column;\n        border-top: 1px solid var(--border);\n    }\n\n    .writing-card {\n        padding: 1.5rem;\n        border-bottom: 1px solid var(--border);\n        text-decoration: none;\n        transition: all 0.3s var(--ease-out);\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 2rem;\n    }\n\n    .writing-card:hover {\n        background: rgba(255, 255, 255, 0.02);\n        padding-left: 0.5rem;\n        border-bottom-color: var(--accent);\n    }\n\n    .writing-card:hover .title {\n        color: var(--accent);\n    }\n\n    .writing-card .title {\n        font-size: 17px;\n        font-weight: 500;\n        color: var(--fg);\n        display: block;\n    }\n\n    .writing-card .meta {\n        font-size: 11px;\n        color: var(--fg-muted);\n        text-transform: uppercase;\n        letter-spacing: 0.15em;\n        opacity: 0.6;\n        display: block;\n        margin-top: 4px;\n    }\n\n    .writing-card .date {\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-size: 12px;\n        color: var(--fg-muted);\n        opacity: 0.4;\n    }\n\n    /* Footer area */\n    .cv-footer {\n        padding: 6rem var(--pad-x);\n        border-top: 1px solid var(--border);\n        max-width: 1200px;\n        margin: 0 auto;\n        display: flex;\n        flex-direction: column;\n        gap: 2rem;\n        align-items: center;\n        text-align: center;\n    }\n\n    @media (min-width: 768px) {\n        .cv-footer {\n            flex-direction: row;\n            justify-content: space-between;\n            text-align: left;\n        }\n    }\n\n    .footer-note {\n        font-size: 13px;\n        color: var(--fg-muted);\n        line-height: 1.6;\n    }\n\n    .footer-note code {\n        background: var(--surface);\n        padding: 2px 6px;\n        border-radius: 4px;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-size: 11px;\n    }\n\n    .footer-stamp {\n        font-size: 12px;\n        color: var(--fg-muted);\n        opacity: 0.5;\n    }\n\n    /* Animations */\n    .reveal {\n        opacity: 0;\n        transform: translateY(20px);\n    }\n</style>\n<div class=\"grain\" data-kid=\"1\" data-name=\"grain noise background overlay\">\n</div>\n<nav class=\"nav\" data-kid=\"2\" data-name=\"main navigation bar\">\n    <div class=\"nav-container\" data-kid=\"2-1\" data-name=\"navigation container\">\n        <a class=\"nav-brand\" data-kid=\"2-1-1\" data-name=\"navigation brand link\" href=\"/\">\n            <div class=\"nav-brand-dot\" data-kid=\"2-1-1-1\" data-name=\"brand accent dot\">\n            </div>\n            Nhat Nguyen\n        </a>\n        <div class=\"nav-links\" data-kid=\"2-1-2\" data-name=\"navigation links container\">\n            <a class=\"nav-link\" data-kid=\"2-1-2-1\" data-name=\"about navigation link\" href=\"/about\">\n                About\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-2-2\" data-name=\"blog navigation link\" href=\"/blog\">\n                Blog\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-2-3\" data-name=\"publications navigation link\" href=\"/publications\">\n                Publications\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-2-4\" data-name=\"projects navigation link\" href=\"/projects\">\n                Projects\n            </a>\n            <a class=\"na