      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Serif:ital,wght@0,400;1,400&family=Fira+Code:wght@300;400;500&display=swap');\n\n    :root {\n        --bg: #0d0a08;\n        --surface: #14110d;\n        --fg: #fafafa;\n        --fg-muted: rgba(250, 250, 250, 0.55);\n        --accent: #f97316;\n        --border: rgba(250, 250, 250, 0.12);\n        --border-strong: rgba(250, 250, 250, 0.18);\n        --font-body: 'DM Sans', sans-serif;\n        --font-display: 'Instrument Serif', serif;\n        --font-mono: 'Fira Code', monospace;\n        --ease: cubic-bezier(0.22, 1, 0.36, 1);\n    }\n\n    body {\n        margin: 0;\n        background-color: var(--bg);\n        color: var(--fg);\n        font-family: var(--font-body);\n        -webkit-font-smoothing: antialiased;\n    }\n\n    .page-noise {\n        position: fixed;\n        inset: 0;\n        pointer-events: none;\n        z-index: 50;\n        opacity: 0.04;\n        background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\");\n    }\n\n    .nav-link {\n        position: relative;\n    }\n\n    .nav-link::after {\n        content: '';\n        position: absolute;\n        bottom: -2px;\n        left: 0;\n        width: 0;\n        height: 1px;\n        background-color: var(--accent);\n        transition: width 0.3s var(--ease);\n    }\n\n    .nav-link:hover {\n        color: var(--fg);\n    }\n\n    .nav-link:hover::after {\n        width: 100%;\n    }\n\n    .nav-link.active {\n        color: var(--fg);\n    }\n    \n    .nav-link.active::after {\n        width: 100%;\n    }\n\n    .marginal-index {\n        writing-mode: vertical-rl;\n        transform: rotate(180deg);\n        user-select: none;\n        letter-spacing: 0.3em;\n    }\n\n    .empty-frame {\n        background: linear-gradient(to bottom, var(--surface), transparent);\n        transition: transform 0.6s var(--ease), border-color 0.6s var(--ease);\n    }\n    \n    .empty-frame:hover {\n        border-color: rgba(250, 250, 250, 0.15);\n        transform: translateY(-2px);\n    }\n\n    .code-glow {\n        box-shadow: 0 0 40px -20px var(--accent);\n    }\n\n    /* Custom underline for Instrument Serif */\n    .editorial-link {\n        border-bottom: 1px solid rgba(249, 115, 22, 0.3);\n        transition: border-color 0.3s var(--ease);\n    }\n    .editorial-link:hover {\n        border-color: var(--accent);\n    }\n</style>\n<div class=\"relative min-h-screen selection:bg-[#f97316]/30 selection:text-white\" data-kid=\"1\" data-name=\"page content wrapper\">\n    <div class=\"page-noise\" data-kid=\"1-1\" data-name=\"background noise texture overlay\">\n    </div>\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 left-0 w-full z-40 border-b border-white/5 bg-[#0d0a08]/80 backdrop-blur-md\" data-kid=\"1-2\" data-name=\"navigation header bar\">\n        <div class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"1-2-1\" data-name=\"navigation flex container\">\n            <a class=\"flex items-center gap-2 group\" data-kid=\"1-2-1-1\" data-name=\"site branding logo link\" href=\"/\">\n                <div class=\"w-5 h-5 bg-white rounded-[4px] flex items-center justify-center transition-transform duration-500 group-hover:rotate-45\" data-kid=\"1-2-1-1-1\" data-name=\"logo icon container\">\n                    <span class=\"text-[10px] text-black font-bold\" data-kid=\"1-2-1-1-1-1\" data-name=\"diamond icon symbol\">\n                        ◆\n                    </span>\n                </div>\n                <span class=\"text-[15px] font-medium tracking-tight\" data-kid=\"1-2-1-1-2\" data-name=\"site owner name text\">\n                    Nhat Nguyen\n                </span>\n            </a>\n            <div class=\"hidden md:flex items-center gap-8\" data-kid=\"1-2-1-2\" data-name=\"navigation menu links container\">\n                <a class=\"nav-link text-[13.5px] text-white/50\" data-kid=\"1-2-1-2-1\" data-name=\"about navigation link\" href=\"/about\">\n                    About\n                </a>\n                <a class=\"nav-link text-[13.5px] text-white/50\" data-kid=\"1-2-1-2-2\" data-name=\"blog navigation link\" href=\"/blog\">\n                    Blog\n                </a>\n                <a class=\"nav-link active text-[13.5px] text-white/50\" data-kid=\"1-2-1-2-3\" data-name=\"publications active navigation link\" href=\"/publications\">\n                    Publications\n                </a>\n                <a class=\"nav-link text-[13.5px] text-white/50\" data-kid=\"1-2-1-2-4\" data-name=\"projects navigation link\" href=\"/projects\">\n                    Projects\n                </a>\n                <a class=\"nav-link text-[13.5px] text-white/50\" data-kid=\"1-2-1-2-5\" data-name=\"cv navigation link\" href=\"/cv\">\n                    CV\n                </a>\n                <a class=\"nav-link text-[13.5px] text-white/50 flex items-center gap-1\" data-kid=\"1-2-1-2-6\" data-name=\"github repository link\" href=\"https://github.com/xdnhatnguyen\">\n                    GitHub\n                    <i class=\"ti ti-arrow-up-right text-[10px]\" data-kid=\"1-2-1-2-6-1\" data-name=\"external link arrow icon\">\n                    </i>\n                </a>\n            </div>\n            <!-- Mobile Menu Placeholder -->\n            <button class=\"md:hidden text-white/50\" data-kid=\"1-2-1-3\" data-name=\"mobile menu toggle button\">\n                <i class=\"ti ti-menu-2 text-xl\" data-kid=\"1-2-1-3-1\" data-name=\"hamburger menu icon\">\n                </i>\n            </button>\n        </div>\n    </nav>\n    <main class=\"max-w-7xl mx-auto px-6 pt-32 pb-24\" data-kid=\"1-3\" data-name=\"main page content area\">\n        <!-- Header Section -->\n        <header class=\"relative mb-20\" data-kid=\"1-3-1\" data-name=\"page header section\">\n            <!-- Marginal Index -->\n            <div class=\"absolute -left-12 top-0 hidden xl:block\" data-kid=\"1-3-1-1\" data-name=\"marginal section index container\">\n                <span class=\"marginal-index text-[10px] font-medium tracking-[0.2em] text-white/20 uppercase\" data-kid=\"1-3-1-1-1\" data-name=\"section index label text\">\n                    Index — 02 / 05\n                </span>\n            </div>\n            <div class=\"max-w-3xl\" data-kid=\"1-3-1-2\" data-name=\"header content container\">\n                <p class=\"text-[12px] font-semibold tracking-[0.15em] text-[#f97316] uppercase mb-4 reveal-up\" data-kid=\"1-3-1-2-1\" data-name=\"eyebrow category text\" id=\"eyebrow\">\n                    Portfolio — Academic\n                </p>\n                <h1 class=\"text-6xl md:text-8xl font-normal font-['Instrument_Serif'] leading-[0.95] mb-6 reveal-up\" data-kid=\"1-3-1-2-2\" data-name=\"page main title text\" id=\"title\">\n                    Publications\n                </h1>\n                <p class=\"text-xl md:text-2xl text-white/60 font-light leading-relaxed reveal-up\" data-kid=\"1-3-1-2-3\" data-name=\"page subheadline text\" id=\"subline\">\n                    Research notes, working papers, and the mathematics behind the experiments.\n                </p>\n            </div>\n        </header>\n        <!-- Bibliography Bar -->\n        <section class=\"border-y border-white/10 py-4 mb-16 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 reveal-up\" data-kid=\"1-3-2\" data-name=\"bibliography utility bar\">\n            <div class=\"flex items-center gap-3 text-[13px] font-mono text-white/40\" data-kid=\"1-3-2-1\" data-name=\"file reference container\">\n                <span class=\"w-2 h-2 rounded-full bg-white/20\" data-kid=\"1-3-2-1-1\" data-name=\"status indicator dot\">\n                </span>\n                <span data-kid=\"1-3-2-1-2\" data-name=\"bibliography file path text\">\n                    /_bibliography/papers.bib\n                </span>\n                <span class=\"text-white/10\" data-kid=\"1-3-2-1-3\" data-name=\"separator dot icon\">\n                    ·\n                </span>\n                <span class=\"bg-white/5 px-2 py-0.5 rounded border border-white/10\" data-kid=\"1-3-2-1-4\" data-name=\"library tool name tag\">\n                    jekyll-scholar\n                </span>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-3-2-2\" data-name=\"citation action buttons container\">\n                <button class=\"text-[13px] text-white/60 hover:text-[#f97316] transition-colors flex items-center gap-2 group cursor-pointer\" data-kid=\"1-3-2-2-1\" data-name=\"cite instruction button\">\n                    How to cite\n                    <i class=\"ti ti-question-mark text-[10px] opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"1-3-2-2-1-1\" data-name=\"question mark icon\">\n                    </i>\n                </button>\n                <button class=\"text-[13px] font-medium text-white/90 hover:text-[#f97316] transition-colors flex items-center gap-2 group cursor-pointer\" data-kid=\"1-3-2-2-2\" data-name=\"bibtex export button\">\n                    Open BibTeX\n                    <i class=\"ti ti-copy text-[14px] text-[#f97316]\" data-kid=\"1-3-2-2-2-1\" data-name=\"copy to clipboard icon\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <!-- Empty State Frame -->\n        <section class=\"mb-24 reveal-up\" data-kid=\"1-3-3\" data-name=\"empty state container\">\n            <div class=\"empty-frame border border-white/5 rounded-2xl p-8 md:p-16 relative overflow-hidden\" data-kid=\"1-3-3-1\" data-name=\"feature card with background blur\">\n                <!-- Abstract geometry in background -->\n                <div class=\"absolute top-0 right-0 w-96 h-96 bg-[#f97316]/5 blur-[120px] rounded-full pointer-events-none\" data-kid=\"1-3-3-1-1\" data-name=\"background glow orb\">\n                </div>\n                <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10\" data-kid=\"1-3-3-1-2\" data-name=\"feature content grid\">\n                    <div data-kid=\"1-3-3-1-2-1\" data-name=\"empty state text content\">\n                        <h2 class=\"text-3xl font-normal font-['Instrument_Serif'] mb-4 italic\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"empty state heading\">\n                            No published entries yet.\n                        </h2>\n                        <p class=\"text-lg text-white/50 leading-relaxed max-w-md mb-8\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"empty state description text\">\n                            The bibliography is taking shape in public — the next entry will appear here when it is ready. I document the process as I go.\n                        </p>\n                        <div class=\"inline-flex items-center gap-3 px-4 py-2 bg-white/[0.03] border border-white/10 rounded-full text-[13px] text-white/60\" data-kid=\"1-3-3-1-2-1-3\" data-name=\"repository tracking status indicator\">\n                            <span class=\"flex h-1.5 w-1.5 relative\" data-kid=\"1-3-3-1-2-1-3-1\" data-name=\"pulsing animation container\">\n                                <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#f97316] opacity-75\" data-kid=\"1-3-3-1-2-1-3-1-1\" data-name=\"outer pinging circle\">\n                                </span>\n                                <span class=\"relative inline-flex rounded-full h-1.5 w-1.5 bg-[#f97316]\" data-kid=\"1-3-3-1-2-1-3-1-2\" data-name=\"inner solid circle\">\n                                </span>\n                            </span>\n                            Tracking bibliography repository for new entries\n                        </div>\n                    </div>\n                    <div class=\"relative group\" data-kid=\"1-3-3-1-2-2\" data-name=\"code block preview container\">\n                        <div class=\"absolute -inset-2 bg-[#f97316]/10 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"code block glow wrapper\">\n                        </div>\n                        <div class=\"relative bg-[#14110d] border border-white/10 rounded-xl p-6 font-mono text-[13px] leading-relaxed code-glow\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"bibtex code content box\">\n                            <div class=\"flex items-center justify-between mb-4 border-b border-white/5 pb-3\" data-kid=\"1-3-3-1-2-2-2-1\" data-name=\"code window title bar\">\n                                <div class=\"flex gap-1.5\" data-kid=\"1-3-3-1-2-2-2-1-1\" data-name=\"window control buttons\">\n                                    <div class=\"w-2.5 h-2.5 rounded-full bg-white/10\" data-kid=\"1-3-3-1-2-2-2-1-1-1\" data-name=\"window control red button\">\n                                    </div>\n                                    <div class=\"w-2.5 h-2.5 rounded-full bg-white/10\" data-kid=\"1-3-3-1-2-2-2-1-1-2\" data-name=\"window control yellow button\">\n                                    </div>\n                                    <div class=\"w-2.5 h-2.5 rounded-full bg-white/10\" data-kid=\"1-3-3-1-2-2-2-1-1-3\" data-name=\"window control green button\">\n                                    </div>\n                                </div>\n                                <span class=\"text-white/20 text-[10px] tracking-widest uppercase\" data-kid=\"1-3-3-1-2-2-2-1-2\" data-name=\"window metadata label\">\n                                    Placeholder Metadata\n                                </span>\n                            </div>\n                            <pre class=\"text-white/40\" data-kid=\"1-3-3-1-2-2-2-2\" data-name=\"code content block\">\n<span class=\"text-[#f97316]\" data-kid=\"1-3-3-1-2-2-2-2-1\" data-name=\"bibtex article keyword\">@article</span>{nguyen2026diffusion,\n  title    = {<span class=\"text-white/70\" data-kid=\"1-3-3-1-2-2-2-2-2\" data-name=\"bibtex title value\">Diffusion models as stochastic systems</span>},\n  author   = {<span class=\"text-white/70\" data-kid=\"1-3-3-1-2-2-2-2-3\" data-name=\"bibtex author value\">Nguyen, Nhat M.</span>},\n  journal  = {<span class=\"text-white/70\" data-kid=\"1-3-3-1-2-2-2-2-4\" data-name=\"bibtex journal value\">Working Paper</span>},\n  year     = {<span class=\"text-white/70\" data-kid=\"1-3-3-1-2-2-2-2-5\" data-name=\"bibtex year value\">2026</span>},\n  selected = {<span class=\"text-[#f97316]\" data-kid=\"1-3-3-1-2-2-2-2-6\" data-name=\"bibtex boolean value\">true</span>}\n}</pre>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Research Directions -->\n        <section class=\"max-w-4xl mx-auto mb-24 reveal-up relative\" data-kid=\"1-3-4\" data-name=\"research directions section\">\n            <!-- Marginal Index for section -->\n            <div class=\"absolute -left-12 top-0 hidden xl:block\" data-kid=\"1-3-4-1\" data-name=\"section marginal index container\">\n                <span class=\"marginal-index text-[10px] font-medium text-white/20 uppercase\" data-kid=\"1-3-4-1-1\" data-name=\"section index label text\">\n                    Index — 03 / 05\n                </span>\n            </div>\n            <div class=\"flex items-end justify-between mb-10 pb-4 border-b border-white/5\" data-kid=\"1-3-4-2\" data-name=\"section header area\">\n                <h3 class=\"text-xl font-medium tracking-tight\" data-kid=\"1-3-4-2-1\" data-name=\"section title heading\">\n                    Research directions\n                </h3>\n                <span class=\"text-[12px] font-mono text-white/20 uppercase tracking-widest italic\" data-kid=\"1-3-4-2-2\" data-name=\"section status label\">\n                    Working Notes\n                </span>\n            </div>\n            <div class=\"space-y-px bg-white/5 border border-white/5 rounded-lg overflow-hidden\" data-kid=\"1-3-4-3\" data-name=\"research list container\">\n                <!-- Row 1 -->\n                <div class=\"bg-[#0d0a08] p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-l-2 border-transparent hover:border-[#f97316] hover:bg-white/[0.02] transition-all duration-300 group\" data-kid=\"1-3-4-3-1\" data-name=\"research item row 1\">\n                    <div class=\"flex items-start gap-4\" data-kid=\"1-3-4-3-1-1\" data-name=\"item details container\">\n                        <span class=\"text-white/20 font-mono text-[13px] pt-1\" data-kid=\"1-3-4-3-1-1-1\" data-name=\"item index label\">\n                            01\n                        </span>\n                        <div data-kid=\"1-3-4-3-1-1-2\" data-name=\"item text content\">\n                            <h4 class=\"text-lg font-medium group-hover:text-white transition-colors\" data-kid=\"1-3-4-3-1-1-2-1\" data-name=\"research title heading\">\n                                Diffusion models as stochastic systems\n                            </h4>\n                            <div class=\"flex flex-wrap gap-2 mt-3\" data-kid=\"1-3-4-3-1-1-2-2\" data-name=\"tags container\">\n                                <span class=\"text-[10px] uppercase tracking-wider bg-white/5 border border-white/10 px-2 py-0.5 rounded text-white/40\" data-kid=\"1-3-4-3-1-1-2-2-1\" data-name=\"working note tag\">\n                                    working note\n                                </span>\n                                <span class=\"text-[10px] uppercase tracking-wider border border-[#f97316]/30 px-2 py-0.5 rounded text-[#f97316]/70\" data-kid=\"1-3-4-3-1-1-2-2-2\" data-name=\"math tag\">\n                                    math\n                                </span>\n                                <span class=\"text-[10px] uppercase tracking-wider border border-white/10 px-2 py-0.5 rounded text-white/40\" data-kid=\"1-3-4-3-1-1-2-2-3\" data-name=\"diffusion tag\">\n                                    diffusion\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <a class=\"text-[13px] text-[#f97316] font-medium opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 transition-all duration-300 flex items-center gap-1\" data-kid=\"1-3-4-3-1-2\" data-name=\"view details link\" href=\"#\">\n                        View research notes\n                        <i class=\"ti ti-arrow-right text-[10px]\" data-kid=\"1-3-4-3-1-2-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n                <!-- Row 2 -->\n                <div class=\"bg-[#0d0a08] p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-l-2 border-transparent hover:border-[#f97316] hover:bg-white/[0.02] transition-all duration-300 group\" data-kid=\"1-3-4-3-2\" data-name=\"research item row 2\">\n                    <div class=\"flex items-start gap-4\" data-kid=\"1-3-4-3-2-1\" data-name=\"item details container\">\n                        <span class=\"text-white/20 font-mono text-[13px] pt-1\" data-kid=\"1-3-4-3-2-1-1\" data-name=\"item index label\">\n                            02\n                        </span>\n                        <div data-kid=\"1-3-4-3-2-1-2\" data-name=\"item text content\">\n                            <h4 class=\"text-lg font-medium group-hover:text-white transition-colors\" data-kid=\"1-3-4-3-2-1-2-1\" data-name=\"research title heading\">\n                                Computer vision experiments\n                            </h4>\n                            <div class=\"flex flex-wrap gap-2 mt-3\" data-kid=\"1-3-4-3-2-1-2-2\" data-name=\"tags container\">\n                                <span class=\"text-[10px] uppercase tracking-wider bg-white/5 border border-white/10 px-2 py-0.5 rounded text-white/40\" data-kid=\"1-3-4-3-2-1-2-2-1\" data-name=\"working note tag\">\n                                    working note\n                                </span>\n                                <span class=\"text-[10px] uppercase tracking-wider border border-white/10 px-2 py-0.5 rounded text-white/40\" data-kid=\"1-3-4-3-2-1-2-2-2\" data-name=\"vision tag\">\n                                    vision\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <a class=\"text-[13px] text-[#f97316] font-medium opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 transition-all duration-300 flex items-center gap-1\" data-kid=\"1-3-4-3-2-2\" data-name=\"view details link\" href=\"#\">\n                        View research notes\n                        <i class=\"ti ti-arrow-right text-[10px]\" data-kid=\"1-3-4-3-2-2-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n                <!-- Row 3 -->\n                <div class=\"bg-[#0d0a08] p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-l-2 border-transparent hover:border-[#f97316] hover:bg-white/[0.02] transition-all duration-300 group border-b-0\" data-kid=\"1-3-4-3-3\" data-name=\"research item row 3\">\n                    <div class=\"flex items-start gap-4\" data-kid=\"1-3-4-3-3-1\" data-name=\"item details container\">\n                        <span class=\"text-white/20 font-mono text-[13px] pt-1\" data-kid=\"1-3-4-3-3-1-1\" data-name=\"item index label\">\n                            03\n                        </span>\n                        <div data-kid=\"1-3-4-3-3-1-2\" data-name=\"item text content\">\n                            <h4 class=\"text-lg font-medium group-hover:text-white transition-colors\" data-kid=\"1-3-4-3-3-1-2-1\" data-name=\"research title heading\">\n                                Optimal control / HJB derivations\n                            </h4>\n                            <div class=\"flex flex-wrap gap-2 mt-3\" data-kid=\"1-3-4-3-3-1-2-2\" data-name=\"tags container\">\n                                <span class=\"text-[10px] uppercase tracking-wider bg-white/5 border border-white/10 px-2 py-0.5 rounded text-white/40\" data-kid=\"1-3-4-3-3-1-2-2-1\" data-name=\"working note tag\">\n                                    working note\n                                </span>\n                                <span class=\"text-[10px] uppercase tracking-wider border border-[#f97316]/30 px-2 py-0.5 rounded text-[#f97316]/70\" data-kid=\"1-3-4-3-3-1-2-2-2\" data-name=\"math tag\">\n                                    math\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <a class=\"text-[13px] text-[#f97316] font-medium opacity-0 group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 transition-all duration-300 flex items-center gap-1\" data-kid=\"1-3-4-3-3-2\" data-name=\"view details link\" href=\"#\">\n                        View research notes\n                        <i class=\"ti ti-arrow-right text-[10px]\" data-kid=\"1-3-4-3-3-2-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"mt-10 pl-12\" data-kid=\"1-3-4-4\" data-name=\"footer action container\">\n                <a class=\"text-[13px] font-medium text-[#f97316] editorial-link pb-1 group flex items-center gap-2 w-fit\" data-kid=\"1-3-4-4-1\" data-name=\"view all notes link\" href=\"#\">\n                    View all research notes\n                    <i class=\"ti ti-arrow-right text-[10px] group-hover:translate-x-1 transition-transform\" data-kid=\"1-3-4-4-1-1\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <!-- Footer Note -->\n        <footer class=\"mt-32 pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 reveal-up\" data-kid=\"1-3-5\" data-name=\"page footer section\">\n            <div class=\"flex items-center gap-4 text-[11px] font-mono text-white/20 uppercase tracking-widest italic\" data-kid=\"1-3-5-1\" data-name=\"footer metadata text group\">\n                <span data-kid=\"1-3-5-1-1\" data-name=\"render engine label\">\n                    Rendered by Jekyll Scholar\n                </span>\n                <span class=\"w-1 h-1 rounded-full bg-white/10\" data-kid=\"1-3-5-1-2\" data-name=\"separator dot icon\">\n                </span>\n                <span data-kid=\"1-3-5-1-3\" data-name=\"data source label\">\n                    Populated by papers.bib\n                </span>\n            </div>\n            <a class=\"flex items-center gap-2 text-sm text-white/60 hover:text-white transition-colors group\" data-kid=\"1-3-5-2\" data-name=\"back to research link\" href=\"/research\">\n                <i class=\"ti ti-arrow-left text-xs group-hover:-translate-x-1 transition-transform\" data-kid=\"1-3-5-2-1\" data-name=\"left arrow icon\">\n                </i>\n                Back to research overview\n            </a>\n            <div class=\"text-[11px] font-mono text-white/20 uppercase tracking-widest\" data-kid=\"1-3-5-3\" data-name=\"copyright notice text\">\n                © 2026 Nhat Nguyen\n            </div>\n        </footer>\n    </main>\n</div>\n<!-- Icons -->\n<link data-kid=\"2\" data-name=\"icon library stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        // Subtle entrance animation using gsap.from\n        gsap.from('.reveal-up', {\n            opacity: 0,\n            y: 30,\n            duration: 1.4,\n            stagger: 0.12,\n            ease: 'power4.out',\n            delay: 0.1\n        });\n\n        // Hover effect on the nav items\n        const navLinks = document.querySelectorAll('.nav-link');\n        navLinks.forEach(link => {\n            link.addEventListener('mouseenter', () => {\n                if(!link.classList.contains('active')) {\n                    gsap.to(link, { color: '#fafafa', duration: 0.3, ease: 'power2.out' });\n                }\n            });\n            link.addEventListener('mouseleave', () => {\n                if(!link.classList.contains('active')) {\n                    gsap.to(link, { color: 'rgba(250, 250, 250, 0.55)', duration: 0.3, ease: 'power2.out' });\n                }\n            });\n        });\n    });\n</script>\n",
      "comments": [],
      "created": "2026-08-06T04:00:27.704074+00:00",
      "modified": "2026-08-06T04:00:27.704074+00:00",
      "id": "var_c725c37a9a62"
    },
    "var_cc8c6d8b7d26": {
      "type": "variant",
      "label": "Projects — Experiments",
      "parentId": "var_ef18b89d8526",
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Serif:ital,wght@0,400;1,400&display=swap');\n\n    :root {\n      --bg: #0d0a08;\n      --surface: #14110d;\n      --fg: #fafafa;\n      --fg-muted: rgba(250, 250, 250, 0.55);\n      --accent: #f97316;\n      --border: rgba(250, 250, 250, 0.1);\n      --font-body: 'DM Sans', sans-serif;\n      --font-display: 'Instrument Serif', serif;\n      --ease: cubic-bezier(0.23, 1, 0.32, 1);\n    }\n\n    body {\n      background-color: var(--bg);\n      color: var(--fg);\n      font-family: var(--font-body);\n      margin: 0;\n      -webkit-font-smoothing: antialiased;\n      overflow-x: clip;\n    }\n\n    .grain {\n      position: fixed;\n      inset: 0;\n      pointer-events: none;\n      z-index: 999;\n      opacity: 0.06;\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3%3Cfilter id='noiseFilter'%3%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    }\n\n    .bg-radial {\n      background: radial-gradient(circle at 50% -20%, rgba(249, 115, 22, 0.04) 0%, rgba(13, 10, 8, 1) 80%);\n    }\n\n    .terminal-scanlines {\n      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02));\n      background-size: 100% 2px, 3px 100%;\n      pointer-events: none;\n    }\n\n    .nav-link {\n      position: relative;\n      transition: color 0.3s var(--ease);\n    }\n    .nav-link::after {\n      content: '';\n      position: absolute;\n      bottom: -2px;\n      left: 0;\n      width: 0;\n      height: 1px;\n      background-color: var(--accent);\n      transition: width 0.3s var(--ease);\n    }\n    .nav-link:hover::after, .nav-link.active::after {\n      width: 100%;\n    }\n    .nav-link.active {\n      color: var(--accent);\n    }\n\n    .project-row {\n      transition: background-color 0.5s var(--ease), padding-left 0.5s var(--ease);\n    }\n    .project-row:hover {\n      background-color: var(--surface);\n      padding-left: 2rem;\n    }\n    .project-row .row-index {\n      transition: transform 0.5s var(--ease), color 0.5s var(--ease);\n    }\n    .project-row:hover .row-index {\n      transform: translateX(0.5rem);\n      color: var(--accent);\n    }\n\n    .btn-underline {\n      position: relative;\n      display: inline-block;\n      padding-bottom: 2px;\n    }\n    .btn-underline::after {\n      content: '';\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      width: 100%;\n      height: 1px;\n      background-color: var(--accent);\n      transform: scaleX(1);\n      transform-origin: left;\n      transition: transform 0.4s var(--ease);\n    }\n    .project-row .btn-underline::after {\n      transform: scaleX(0);\n    }\n    .project-row:hover .btn-underline::after {\n      transform: scaleX(1);\n    }\n\n    .terminal-glow {\n      box-shadow: 0 0 40px -10px rgba(249, 115, 22, 0.08), inset 0 0 20px rgba(0,0,0,0.4);\n    }\n\n    .motif-sde {\n      position: absolute;\n      width: 150px;\n      height: 150px;\n      border: 1px solid rgba(249, 115, 22, 0.1);\n      border-radius: 50%;\n      top: 50%;\n      right: 10%;\n      transform: translateY(-50%) rotate(0deg);\n      opacity: 0.05;\n      transition: opacity 0.6s var(--ease), transform 2s linear, border-color 0.6s var(--ease);\n    }\n    .project-row:hover .motif-sde {\n      opacity: 0.2;\n      transform: translateY(-50%) rotate(90deg);\n      border-color: rgba(249, 115, 22, 0.4);\n    }\n    .motif-sde::before {\n      content: '';\n      position: absolute;\n      inset: 10px;\n      border: 1px dashed rgba(249, 115, 22, 0.3);\n      border-radius: 50%;\n    }\n\n    .motif-atlas {\n      position: absolute;\n      width: 200px;\n      height: 2px;\n      background: linear-gradient(90deg, transparent, rgba(249, 115, 22, 0.4), transparent);\n      top: 50%;\n      right: 10%;\n      opacity: 0.08;\n      transition: opacity 0.6s var(--ease), width 0.8s var(--ease);\n    }\n    .project-row:hover .motif-atlas {\n      opacity: 0.4;\n      width: 280px;\n    }\n\n    /* Custom Selection Color */\n    ::selection {\n      background: var(--accent);\n      color: var(--bg);\n    }\n</style>\n<div class=\"grain\" data-kid=\"1\" data-name=\"grain overlay texture\">\n</div>\n<main class=\"min-h-screen pt-12 pb-24 px-6 md:px-12 lg:px-24 bg-radial\" data-kid=\"2\" data-name=\"main page layout\">\n    <!-- Header & Nav -->\n    <header class=\"max-w-[1440px] mx-auto mb-16 lg:mb-24\" data-kid=\"2-1\" data-name=\"header section\">\n        <nav class=\"flex flex-wrap items-center gap-x-10 gap-y-4 mb-20 text-[13px] font-medium tracking-tight text-[#fafafa]/40 uppercase\" data-kid=\"2-1-1\" data-name=\"navigation bar\">\n            <a class=\"nav-link text-[#fafafa]\" data-kid=\"2-1-1-1\" data-name=\"navigation link name\" href=\"#\">\n                Nhat Nguyen\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-1-2\" data-name=\"navigation link\" href=\"#\">\n                About\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-1-3\" data-name=\"navigation link\" href=\"#\">\n                Blog\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-1-4\" data-name=\"navigation link\" href=\"#\">\n                Publications\n            </a>\n            <a class=\"nav-link active\" data-kid=\"2-1-1-5\" data-name=\"navigation link active\" href=\"#\">\n                Projects\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-1-6\" data-name=\"navigation link\" href=\"#\">\n                CV\n            </a>\n            <a class=\"nav-link\" data-kid=\"2-1-1-7\" data-name=\"navigation link\" href=\"#\">\n                GitHub\n            </a>\n        </nav>\n        <div class=\"flex flex-col lg:flex-row justify-between items-start lg:items-end gap-12\" data-kid=\"2-1-2\" data-name=\"header content container\">\n            <div class=\"max-w-2xl\" data-kid=\"2-1-2-1\" data-name=\"header text block\">\n                <h1 class=\"font-['Instrument_Serif'] text-7xl md:text-8xl lg:text-9xl italic leading-[0.85] tracking-tight mb-8\" data-kid=\"2-1-2-1-1\" data-name=\"hero headline\">\n                    Projects\n                </h1>\n                <p class=\"text-xl md:text-2xl text-[#fafafa]/50 leading-relaxed font-light\" data-kid=\"2-1-2-1-2\" data-name=\"hero subheadline\">\n                    Experiments that make the\n                    <span class=\"italic text-[#fafafa]\" data-kid=\"2-1-2-1-2-1\" data-name=\"emphasized text\">\n                        next question\n                    </span>\n                    clearer.\n                </p>\n            </div>\n            <div class=\"flex flex-col items-start lg:items-end gap-6 w-full lg:w-auto\" data-kid=\"2-1-2-2\" data-name=\"header action container\">\n                <div class=\"flex items-center gap-3 font-mono text-[10px] tracking-[0.3em] text-[#f97316] uppercase border border-[#f97316]/20 py-2 px-4 rounded-full\" data-kid=\"2-1-2-2-1\" data-name=\"site status indicator\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[#f97316] animate-pulse\" data-kid=\"2-1-2-2-1-1\" data-name=\"pulsing status dot\">\n                    </span>\n                    site.projects · sort: importance\n                </div>\n                <div class=\"flex gap-8 text-[13px] font-medium tracking-widest uppercase text-[#fafafa]/30\" data-kid=\"2-1-2-2-2\" data-name=\"filter menu\">\n                    <a class=\"text-[#f97316] border-b border-[#f97316] pb-1\" data-kid=\"2-1-2-2-2-1\" data-name=\"filter active link\" href=\"#\">\n                        all\n                    </a>\n                    <a class=\"hover:text-[#fafafa] transition-colors\" data-kid=\"2-1-2-2-2-2\" data-name=\"filter link\" href=\"#\">\n                        live\n                    </a>\n                    <a class=\"hover:text-[#fafafa] transition-colors\" data-kid=\"2-1-2-2-2-3\" data-name=\"filter link\" href=\"#\">\n                        study\n                    </a>\n                    <a class=\"hover:text-[#fafafa] transition-colors\" data-kid=\"2-1-2-2-2-4\" data-name=\"filter link\" href=\"#\">\n                        work\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"w-full h-px bg-[var(--border)] mt-12\" data-kid=\"2-1-3\" data-name=\"header bottom separator\">\n        </div>\n    </header>\n    <!-- Main Content -->\n    <div class=\"max-w-[1440px] mx-auto space-y-20 lg:space-y-32\" data-kid=\"2-2\" data-name=\"main project content container\">\n        <!-- Featured Project 01 -->\n        <section class=\"grid grid-cols-12 gap-y-12 lg:gap-x-16 items-start\" data-kid=\"2-2-1\" data-name=\"featured project section\">\n            <div class=\"col-span-12 lg:col-span-5 space-y-10 order-2 lg:order-1\" data-kid=\"2-2-1-1\" data-name=\"project text details\">\n                <div class=\"space-y-6\" data-kid=\"2-2-1-1-1\" data-name=\"project meta information\">\n                    <div class=\"flex items-center gap-4 text-[10px] font-mono tracking-[0.2em] text-[#f97316] uppercase\" data-kid=\"2-2-1-1-1-1\" data-name=\"project study id\">\n                        <span data-kid=\"2-2-1-1-1-1-1\" data-name=\"project id text\">\n                            study / 01\n                        </span>\n                        <div class=\"h-px flex-1 bg-[#f97316]/20\" data-kid=\"2-2-1-1-1-1-2\" data-name=\"project meta divider\">\n                        </div>\n                    </div>\n                    <h2 class=\"font-['Instrument_Serif'] text-5xl md:text-6xl italic leading-tight\" data-kid=\"2-2-1-1-1-2\" data-name=\"project title\">\n                        Digits Classification Project\n                    </h2>\n                    <p class=\"text-[#fafafa]/60 text-lg leading-relaxed max-w-lg\" data-kid=\"2-2-1-1-1-3\" data-name=\"project description\">\n                        <span class=\"text-[#fafafa]\" data-kid=\"2-2-1-1-1-3-1\" data-name=\"project role highlight\">\n                            Team Lead\n                        </span>\n                        · CNN vs. MLP benchmark for digit recognition. Comparative analysis of architectural efficiency in stochastic gradients and feature maps.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-3\" data-kid=\"2-2-1-1-2\" data-name=\"project tags container\">\n                    <span class=\"px-4 py-1.5 rounded-full bg-[#14110d] border border-[var(--border)] text-[11px] font-mono text-[#fafafa]/40\" data-kid=\"2-2-1-1-2-1\" data-name=\"project tag\">\n                        PyTorch\n                    </span>\n                    <span class=\"px-4 py-1.5 rounded-full bg-[#14110d] border border-[var(--border)] text-[11px] font-mono text-[#fafafa]/40\" data-kid=\"2-2-1-1-2-2\" data-name=\"project tag\">\n                        Python\n                    </span>\n                    <span class=\"px-4 py-1.5 rounded-full bg-[#14110d] border border-[var(--border)] text-[11px] font-mono text-[#fafafa]/40\" data-kid=\"2-2-1-1-2-3\" data-name=\"project tag\">\n                        MNIST\n                    </span>\n                </div>\n                <div class=\"flex gap-10 pt-4\" data-kid=\"2-2-1-1-3\" data-name=\"project link container\">\n                    <a class=\"text-sm font-medium btn-underline hover:text-[#f97316]\" data-kid=\"2-2-1-1-3-1\" data-name=\"project read link\" href=\"#\">\n                        Read project →\n                    </a>\n                    <a class=\"text-sm font-medium text-[#fafafa]/40 hover:text-[#f97316] transition-all flex items-center gap-1 group/gh\" data-kid=\"2-2-1-1-3-2\" data-name=\"project github link\" href=\"#\">\n                        Open GitHub\n                        <span class=\"text-[10px] opacity-50 group-hover/gh:translate-x-0.5 group-hover/gh:-translate-y-0.5 transition-transform duration-300\" data-kid=\"2-2-1-1-3-2-1\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-span-12 lg:col-span-7 order-1 lg:order-2\" data-kid=\"2-2-1-2\" data-name=\"project visualization container\">\n                <div class=\"bg-[#14110d] border border-[var(--border)] rounded-2xl p-6 lg:p-10 terminal-glow relative overflow-hidden group\" data-kid=\"2-2-1-2-1\" data-name=\"terminal interface card\">\n                    <div class=\"terminal-scanlines absolute inset-0 z-0 opacity-20\" data-kid=\"2-2-1-2-1-1\" data-name=\"terminal scanlines\">\n                    </div>\n                    <!-- Abstract CSS Graph Motif -->\n                    <div class=\"absolute inset-0 opacity-10 pointer-events-none transition-transform duration-700 group-hover:scale-105\" data-kid=\"2-2-1-2-1-2\" data-name=\"abstract graph motif\">\n                        <svg class=\"w-full h-full text-[#f97316]\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"graph vector lines\" viewbox=\"0 0 800 500\">\n                            <path d=\"M50,450 C150,50 250,400 350,150 S550,50 750,300\" fill=\"none\" stroke=\"currentColor\" stroke-dasharray=\"4 4\" stroke-width=\"0.5\">\n                            </path>\n                            <circle cx=\"50\" cy=\"450\" fill=\"currentColor\" r=\"3\">\n                            </circle>\n                            <circle cx=\"350\" cy=\"150\" fill=\"currentColor\" r=\"3\">\n                            </circle>\n                            <circle cx=\"750\" cy=\"300\" fill=\"currentColor\" r=\"3\">\n                            </circle>\n                        </svg>\n                    </div>\n                    <div class=\"relative z-10 font-mono text-[13px] leading-relaxed\" data-kid=\"2-2-1-2-1-3\" data-name=\"terminal content area\">\n                        <div class=\"flex items-center justify-between mb-8 border-b border-[#fafafa]/5 pb-6\" data-kid=\"2-2-1-2-1-3-1\" data-name=\"terminal header bar\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"2-2-1-2-1-3-1-1\" data-name=\"terminal status icons\">\n                                <div class=\"flex gap-1.5\" data-kid=\"2-2-1-2-1-3-1-1-1\" data-name=\"terminal window controls\">\n                                    <div class=\"w-2.5 h-2.5 rounded-full bg-[#f97316]/60 shadow-[0_0_8px_rgba(249,115,22,0.4)]\" data-kid=\"2-2-1-2-1-3-1-1-1-1\" data-name=\"control button\">\n                                    </div>\n                                    <div class=\"w-2.5 h-2.5 rounded-full bg-[#fafafa]/10\" data-kid=\"2-2-1-2-1-3-1-1-1-2\" data-name=\"control button\">\n                                    </div>\n                                    <div class=\"w-2.5 h-2.5 rounded-full bg-[#fafafa]/10\" data-kid=\"2-2-1-2-1-3-1-1-1-3\" data-name=\"control button\">\n                                    </div>\n                                </div>\n                                <span class=\"text-[#f97316] font-semibold ml-4\" data-kid=\"2-2-1-2-1-3-1-1-2\" data-name=\"terminal filename\">\n                                    mnist_benchmarking.py\n                                </span>\n                            </div>\n                            <span class=\"text-[10px] text-[#fafafa]/20 uppercase tracking-widest\" data-kid=\"2-2-1-2-1-3-1-2\" data-name=\"terminal encoding label\">\n                                utf-8\n                            </span>\n                        </div>\n                        <div class=\"space-y-4 text-[#fafafa]/40\" data-kid=\"2-2-1-2-1-3-2\" data-name=\"terminal output text\">\n                            <div class=\"flex gap-6\" data-kid=\"2-2-1-2-1-3-2-1\" data-name=\"log row\">\n                                <span class=\"text-[#fafafa]/20 w-4 text-right\" data-kid=\"2-2-1-2-1-3-2-1-1\" data-name=\"log line number\">\n                                    1\n                                </span>\n                                <span data-kid=\"2-2-1-2-1-3-2-1-2\" data-name=\"log content\">\n                                    <span class=\"text-[#f97316]\" data-kid=\"2-2-1-2-1-3-2-1-2-1\" data-name=\"code keyword\">\n                                        import\n                                    </span>\n                                    torch.nn\n                                    <span class=\"text-[#f97316]\" data-kid=\"2-2-1-2-1-3-2-1-2-2\" data-name=\"code keyword\">\n                                        as\n                                    </span>\n                                    nn\n                                </span>\n                            </div>\n                            <div class=\"flex gap-6\" data-kid=\"2-2-1-2-1-3-2-2\" data-name=\"log row\">\n                                <span class=\"text-[#fafafa]/20 w-4 text-right\" data-kid=\"2-2-1-2-1-3-2-2-1\" data-name=\"log line number\">\n                                    2\n                                </span>\n                                <span data-kid=\"2-2-1-2-1-3-2-2-2\" data-name=\"log content\">\n                                    loading\n                                    <span class=\"text-[#fafafa]/80 italic\" data-kid=\"2-2-1-2-1-3-2-2-2-1\" data-name=\"log filename\">\n                                        cnn_interface.png\n                                    </span>\n                                    ...\n                                    <span class=\"text-emerald-500/50\" data-kid=\"2-2-1-2-1-3-2-2-2-2\" data-name=\"log status\">\n                                        done\n                                    </span>\n                                </span>\n                            </div>\n                            <div class=\"flex gap-6\" data-kid=\"2-2-1-2-1-3-2-3\" data-name=\"log row\">\n                                <span class=\"text-[#fafafa]/20 w-4 text-right\" data-kid=\"2-2-1-2-1-3-2-3-1\" data-name=\"log line number\">\n                                    3\n                                </span>\n                                <span data-kid=\"2-2-1-2-1-3-2-3-2\" data-name=\"log content\">\n                                    loading\n                                    <span class=\"text-[#fafafa]/80 italic\" data-kid=\"2-2-1-2-1-3-2-3-2-1\" data-name=\"log filename\">\n                                        mlp_interface.png\n                                    </span>\n                                    ...\n                                    <span class=\"text-emerald-500/50\" data-kid=\"2-2-1-2-1-3-2-3-2-2\" data-name=\"log status\">\n                                        done\n                                    </span>\n                                </span>\n                            </div>\n                            <div class=\"flex gap-6 mt-10\" data-kid=\"2-2-1-2-1-3-2-4\" data-name=\"result callout\">\n                                <span class=\"text-[#fafafa]/20 w-4 text-right\" data-kid=\"2-2-1-2-1-3-2-4-1\" data-name=\"log line number\">\n                                    12\n                                </span>\n                                <div class=\"flex-1 bg-[#f97316]/8 border-l-2 border-[#f97316]/60 p-5 rounded-r-lg space-y-2 backdrop-blur-sm\" data-kid=\"2-2-1-2-1-3-2-4-2\" data-name=\"result box\">\n                                    <p class=\"text-[#fafafa]/90 font-bold tracking-tight\" data-kid=\"2-2-1-2-1-3-2-4-2-1\" data-name=\"result title\">\n                                        Training Complete\n                                    </p>\n                                    <div class=\"grid grid-cols-2 gap-4\" data-kid=\"2-2-1-2-1-3-2-4-2-2\" data-name=\"result metrics grid\">\n                                        <div data-kid=\"2-2-1-2-1-3-2-4-2-2-1\" data-name=\"metric block\">\n                                            <p class=\"text-[11px] uppercase tracking-tighter opacity-50\" data-kid=\"2-2-1-2-1-3-2-4-2-2-1-1\" data-name=\"metric label\">\n                                                accuracy\n                                            </p>\n                                            <p class=\"text-xl text-[#f97316]\" data-kid=\"2-2-1-2-1-3-2-4-2-2-1-2\" data-name=\"metric value\">\n                                                99.28%\n                                            </p>\n                                        </div>\n                                        <div data-kid=\"2-2-1-2-1-3-2-4-2-2-2\" data-name=\"metric block\">\n                                            <p class=\"text-[11px] uppercase tracking-tighter opacity-50\" data-kid=\"2-2-1-2-1-3-2-4-2-2-2-1\" data-name=\"metric label\">\n                                                loss\n                                            </p>\n                                            <p class=\"text-xl text-emerald-500/60\" data-kid=\"2-2-1-2-1-3-2-4-2-2-2-2\" data-name=\"metric value\">\n                                                0.0241\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-6\" data-kid=\"2-2-1-2-1-3-2-5\" data-name=\"log row\">\n                                <span class=\"text-[#fafafa]/10 w-4 text-right\" data-kid=\"2-2-1-2-1-3-2-5-1\" data-name=\"log line number\">\n                                    13\n                                </span>\n                                <span class=\"text-[11px] opacity-20 italic\" data-kid=\"2-2-1-2-1-3-2-5-2\" data-name=\"log metadata\">\n                                    # Environment reproducible: True. Seed: 42\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Asymmetric Row Index Section -->\n        <section class=\"space-y-0\" data-kid=\"2-2-2\" data-name=\"project index section\">\n            <!-- Row 02 -->\n            <article class=\"project-row relative border-t border-[var(--border)] py-16 group cursor-pointer\" data-kid=\"2-2-2-1\" data-name=\"project list row\">\n                <div class=\"motif-sde\" data-kid=\"2-2-2-1-1\" data-name=\"decorative motif\">\n                </div>\n                <div class=\"grid grid-cols-12 gap-8 items-center px-4\" data-kid=\"2-2-2-1-2\" data-name=\"project information grid\">\n                    <div class=\"col-span-1\" data-kid=\"2-2-2-1-2-1\" data-name=\"row index container\">\n                        <span class=\"row-index font-mono text-sm text-[#fafafa]/40 inline-block\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"row index number\">\n                            02\n                        </span>\n                    </div>\n                    <div class=\"col-span-12 md:col-span-5 lg:col-span-4\" data-kid=\"2-2-2-1-2-2\" data-name=\"project title container\">\n                        <div class=\"space-y-2\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"project info stack\">\n                            <span class=\"text-[10px] uppercase tracking-[0.3em] text-[#fafafa]/30 font-mono\" data-kid=\"2-2-2-1-2-2-1-1\" data-name=\"project category\">\n                                research\n                            </span>\n                            <h3 class=\"font-['Instrument_Serif'] text-4xl lg:text-5xl italic group-hover:text-[#f97316] transition-colors\" data-kid=\"2-2-2-1-2-2-1-2\" data-name=\"project title\">\n                                Diffusion Notes\n                            </h3>\n                        </div>\n                    </div>\n                    <div class=\"col-span-12 md:col-span-6 lg:col-span-5 space-y-4\" data-kid=\"2-2-2-1-2-3\" data-name=\"project description container\">\n                        <p class=\"text-[#fafafa]/50 leading-relaxed text-base max-w-md\" data-kid=\"2-2-2-1-2-3-1\" data-name=\"project summary\">\n                            SDE 기반 생성 모델의 확률적 해석과 score matching 기법에 대한 고찰. Explorations into continuous time generative modeling.\n                        </p>\n                        <div class=\"flex gap-4 text-[11px] font-mono text-[#fafafa]/30\" data-kid=\"2-2-2-1-2-3-2\" data-name=\"tag list\">\n                            <span data-kid=\"2-2-2-1-2-3-2-1\" data-name=\"tag\">\n                                #SDE\n                            </span>\n                            <span data-kid=\"2-2-2-1-2-3-2-2\" data-name=\"tag\">\n                                #score-matching\n                            </span>\n                            <span data-kid=\"2-2-2-1-2-3-2-3\" data-name=\"tag\">\n                                #vision\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"col-span-12 lg:col-span-2 text-right\" data-kid=\"2-2-2-1-2-4\" data-name=\"row link container\">\n                        <a class=\"btn-underline text-sm font-medium tracking-tight\" data-kid=\"2-2-2-1-2-4-1\" data-name=\"row link\" href=\"#\">\n                            Read project →\n                        </a>\n                    </div>\n                </div>\n            </article>\n            <!-- Row 03 -->\n            <article class=\"project-row relative border-t border-b border-[var(--border)] py-16 group cursor-pointer\" data-kid=\"2-2-2-2\" data-name=\"project list row\">\n                <div class=\"motif-atlas\" data-kid=\"2-2-2-2-1\" data-name=\"decorative motif\">\n                </div>\n                <div class=\"grid grid-cols-12 gap-8 items-center px-4\" data-kid=\"2-2-2-2-2\" data-name=\"project information grid\">\n                    <div class=\"col-span-1\" data-kid=\"2-2-2-2-2-1\" data-name=\"row index container\">\n                        <span class=\"row-index font-mono text-sm text-[#fafafa]/40 inline-block\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"row index number\">\n                            03\n                        </span>\n                    </div>\n                    <div class=\"col-span-12 md:col-span-5 lg:col-span-4\" data-kid=\"2-2-2-2-2-2\" data-name=\"project title container\">\n                        <div class=\"space-y-2\" data-kid=\"2-2-2-2-2-2-1\" data-name=\"project info stack\">\n                            <span class=\"text-[10px] uppercase tracking-[0.3em] text-[#fafafa]/30 font-mono\" data-kid=\"2-2-2-2-2-2-1-1\" data-name=\"project category\">\n                                notes\n                            </span>\n                            <h3 class=\"font-['Instrument_Serif'] text-4xl lg:text-5xl italic group-hover:text-[#f97316] transition-colors\" data-kid=\"2-2-2-2-2-2-1-2\" data-name=\"project title\">\n                                ODE / SDE Atlas\n                            </h3>\n                        </div>\n                    </div>\n                    <div class=\"col-span-12 md:col-span-6 lg:col-span-5 space-y-4\" data-kid=\"2-2-2-2-2-3\" data-name=\"project description container\">\n                        <p class=\"text-[#fafafa]/50 leading-relaxed text-base max-w-md\" data-kid=\"2-2-2-2-2-3-1\" data-name=\"project summary\">\n                            Neural Ordinary Differential Equations and their stochastic counterparts. Dynamics of infinite-depth networks.\n                        </p>\n                        <div class=\"flex gap-4 text-[11px] font-mono text-[#fafafa]/30\" data-kid=\"2-2-2-2-2-3-2\" data-name=\"tag list\">\n                            <span data-kid=\"2-2-2-2-2-3-2-1\" data-name=\"tag\">\n                                #calculus\n                            </span>\n                            <span data-kid=\"2-2-2-2-2-3-2-2\" data-name=\"tag\">\n                                #dynamics\n                            </span>\n                            <span data-kid=\"2-2-2-2-2-3-2-3\" data-name=\"tag\">\n                                #PDE\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"col-span-12 lg:col-span-2 text-right\" data-kid=\"2-2-2-2-2-4\" data-name=\"row link container\">\n                        <a class=\"btn-underline text-sm font-medium tracking-tight\" data-kid=\"2-2-2-2-2-4-1\" data-name=\"row link\" href=\"#\">\n                            Explore notes →\n                        </a>\n                    </div>\n                </div>\n            </article>\n        </section>\n    </div>\n    <!-- Footer Note -->\n    <footer class=\"max-w-[1440px] mx-auto mt-48 lg:mt-64 border-t border-[var(--border)] pt-12\" data-kid=\"2-3\" data-name=\"footer section\">\n        <div class=\"flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"2-3-1\" data-name=\"footer grid container\">\n            <p class=\"text-[11px] font-mono tracking-[0.3em] text-[#fafafa]/20 uppercase text-center md:text-left\" data-kid=\"2-3-1-1\" data-name=\"footer disclaimer\">\n                Projects are rendered from\n                <span class=\"text-[#f97316]\" data-kid=\"2-3-1-1-1\" data-name=\"project source path\">\n                    _projects/\n                </span>\n                collection with\n                <span class=\"text-[#fafafa]/40\" data-kid=\"2-3-1-1-2\" data-name=\"sorting method\">\n                    importance-based sorting\n                </span>\n                .\n            </p>\n            <div class=\"flex items-center gap-6 text-[11px] font-medium tracking-widest text-[#fafafa]/30 uppercase\" data-kid=\"2-3-1-2\" data-name=\"footer links\">\n                <a class=\"hover:text-[#fafafa] transition-colors\" data-kid=\"2-3-1-2-1\" data-name=\"footer navigation link\" href=\"#\">\n                    GitHub\n                </a>\n                <span class=\"w-1 h-1 rounded-full bg-[#fafafa]/10\" data-kid=\"2-3-1-2-2\" data-name=\"dot separator\">\n                </span>\n                <a class=\"hover:text-[#fafafa] transition-colors\" data-kid=\"2-3-1-2-3\" data-name=\"footer navigation link\" href=\"#\">\n                    Feed\n                </a>\n                <span class=\"w-1 h-1 rounded-full bg-[#fafafa]/10\" data-kid=\"2-3-1-2-4\" data-name=\"dot separator\">\n                </span>\n                <a class=\"hover:text-[#fafafa] transition-colors\" data-kid=\"2-3-1-2-5\" data-name=\"footer navigation link\" href=\"#\">\n                    Archive\n                </a>\n            </div>\n        </div>\n    </footer>\n</main>\n",
